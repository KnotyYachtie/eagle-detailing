---
import { NAV_MAIN, NAV_SERVICES, SITE } from '../site';
import logoEagle from '../../assets/branding/logo-eagle-transparent.png';
import logoText from '../../assets/branding/logo-text-transparent.png';

interface Props {
  closingPromo?: boolean;
}

const { closingPromo = false } = Astro.props;

const year = new Date().getFullYear();
const exploreLinks = [...NAV_SERVICES, ...NAV_MAIN];
---

<footer class:list={['site-footer', closingPromo && 'site-footer--home-close']}>
  {
    closingPromo && (
      <div class="site-footer__promo">
        <div class="u-container site-footer__promo-inner">
          <div class="site-footer__promo-copy">
            <p class="site-footer__promo-title">Discuss your vessel or aircraft</p>
            <p class="site-footer__promo-sub">Call, email, or message — we respond promptly.</p>
          </div>
          <ul class="site-footer__promo-actions" aria-label="Get in touch">
            <li>
              <a class="site-footer__promo-link site-footer__promo-link--primary" href="/contact">
                Contact
              </a>
            </li>
            <li>
              <a
                class="site-footer__promo-link"
                href={SITE.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Instagram
              </a>
            </li>
          </ul>
        </div>
      </div>
    )
  }
  <div class="u-container site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__col site-footer__col--brand">
        <a class="site-footer__brand" href="/" aria-label={`${SITE.shortName} home`}>
          <img
            class="site-footer__logo site-footer__logo--eagle"
            src={logoEagle.src}
            width={logoEagle.width}
            height={logoEagle.height}
            alt={SITE.shortName}
            decoding="async"
          />
          <img
            class="site-footer__logo site-footer__logo--text"
            src={logoText.src}
            width={logoText.width}
            height={logoText.height}
            alt=""
            decoding="async"
          />
        </a>
        <p class="site-footer__tagline">{SITE.tagline}</p>
        <a
          class="site-footer__social-link"
          href={SITE.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Instagram (${SITE.instagramHandle})`}
        >
          <svg class="site-footer__social-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
            <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
            <circle cx="12" cy="12" r="4.25"></circle>
            <circle cx="17.25" cy="6.75" r="1.25" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      </div>

      <nav class="site-footer__col site-footer__col--explore" aria-label="Explore">
        <p class="site-footer__label">Explore</p>
        <ul class="site-footer__explore-list">
          {
            exploreLinks.map(({ href, label }) => (
              <li>
                <a class="site-footer__link" href={href}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col site-footer__col--contact">
        <p class="site-footer__label">Contact</p>
        <ul class="site-footer__contact-list">
          <li class="site-footer__contact-row">
            <svg class="site-footer__contact-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            <a class="site-footer__contact-link" href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a>
          </li>
          <li class="site-footer__contact-row">
            <svg class="site-footer__contact-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path>
              <path d="m22 6-10 7L2 6"></path>
            </svg>
            <a class="site-footer__contact-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
          <li class="site-footer__contact-row">
            <svg class="site-footer__contact-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 21s7-4.35 7-11a7 7 0 1 0-14 0c0 6.65 7 11 7 11z"></path>
              <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
            <span class="site-footer__contact-text">{SITE.locality}, {SITE.region}</span>
          </li>
        </ul>
        <p class="site-footer__client-note">
          Existing client?{' '}
          <a class="site-footer__contact-link" href={`sms:${SITE.phoneTel}`}>Text us</a>
        </p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__legal site-footer__legal--copyright">
        © {year} {SITE.name}. All rights reserved.
      </p>
      <p class="site-footer__legal site-footer__legal--meta">
        <a class="site-footer__legal-link" href="/privacy">Privacy</a>
        <span aria-hidden="true"> · </span>
        Based in {SITE.locality}, {SITE.region}. Licensed &amp; insured.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 39;
    margin-top: auto;
    padding-top: clamp(2rem, 5vw, 3.25rem);
    padding-bottom: max(clamp(1.25rem, 4vw, 2rem), env(safe-area-inset-bottom, 0px));
    background-color: var(--footer-bg);
    border-top: 1px solid rgba(239, 236, 231, 0.05);
  }

  .site-footer--home-close {
    border-top: none;
    padding-top: 0;
    background-color: var(--page-close-floor, var(--footer-bg));
  }

  .site-footer__promo {
    padding-block: clamp(1.35rem, 3.5vw, 2rem);
  }

  .site-footer__promo-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(0.85rem, 2.5vw, 1.15rem);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .site-footer__promo-inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: clamp(1.5rem, 4vw, 2.5rem);
    }
  }

  .site-footer__promo-title {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: rgba(242, 245, 250, 0.96);
  }

  .site-footer__promo-sub {
    margin: 0;
    max-width: 28rem;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgba(168, 186, 214, 0.72);
  }

  .site-footer__promo-actions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1rem, 3vw, 1.75rem);
  }

  .site-footer__promo-link {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(196, 184, 150, 0.92);
    transition: color 0.18s ease;
  }

  .site-footer__promo-link:hover {
    color: #fff;
  }

  .site-footer__promo-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .site-footer__promo-link--primary {
    color: rgba(239, 236, 231, 0.96);
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-color: rgba(196, 184, 150, 0.55);
  }

  .site-footer__promo-link--primary:hover {
    text-decoration-color: rgba(196, 184, 150, 0.9);
  }

  .site-footer__inner {
    position: relative;
  }

  .site-footer--home-close .site-footer__inner {
    padding-top: clamp(1.5rem, 4vw, 2.35rem);
    border-top: 1px solid rgba(239, 236, 231, 0.06);
  }

  .site-footer__grid {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.25rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.35rem);
    grid-template-columns: 1fr;
    grid-template-areas:
      'brand'
      'explore'
      'contact';
  }

  .site-footer__col--brand {
    grid-area: brand;
  }

  .site-footer__col--explore {
    grid-area: explore;
  }

  .site-footer__col--contact {
    grid-area: contact;
  }

  @media (max-width: 767px) {
    .site-footer__grid {
      justify-items: center;
      text-align: center;
    }

    .site-footer__brand {
      justify-content: center;
    }

    .site-footer__explore-list {
      justify-items: center;
    }

    .site-footer__contact-row {
      justify-content: center;
    }

    .site-footer__bottom {
      align-items: center;
      text-align: center;
    }

    .site-footer__client-note {
      text-align: center;
    }
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr) minmax(0, 1.1fr);
      grid-template-areas: 'brand explore contact';
      column-gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: #fff;
  }

  .site-footer__brand:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .site-footer__logo {
    display: block;
    flex: 0 0 auto;
    height: auto;
  }

  .site-footer__logo--eagle {
    width: 2.35rem;
  }

  .site-footer__logo--text {
    width: clamp(7rem, 16vw, 8.75rem);
    margin-top: 0.08rem;
  }

  .site-footer__tagline {
    margin: 0.7rem 0 0.65rem;
    max-width: 18rem;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    line-height: 1.45;
    color: rgba(239, 236, 231, 0.68);
  }

  .site-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.78);
    transition: color 0.15s ease;
  }

  .site-footer__social-link:hover {
    color: #fff;
  }

  .site-footer__social-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .site-footer__social-icon {
    width: 1.05rem;
    height: 1.05rem;
  }

  .site-footer__label {
    margin: 0 0 0.65rem;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    opacity: 0.88;
  }

  .site-footer__explore-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  .site-footer__link {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    color: rgba(239, 236, 231, 0.85);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer__link:hover {
    color: #fff;
  }

  .site-footer__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .site-footer__contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .site-footer__contact-row {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .site-footer__contact-icon {
    flex-shrink: 0;
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.18rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .site-footer__contact-link {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    color: rgba(239, 236, 231, 0.9);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    transition: color 0.15s ease;
  }

  .site-footer__contact-link:hover {
    color: #fff;
  }

  .site-footer__contact-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .site-footer__contact-text {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    color: rgba(239, 236, 231, 0.78);
  }

  .site-footer__client-note {
    margin: 0.85rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgba(239, 236, 231, 0.58);
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    padding-top: clamp(0.85rem, 2vw, 1.1rem);
    border-top: 1px solid rgba(239, 236, 231, 0.06);
  }

  @media (min-width: 768px) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
  }

  .site-footer__legal {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: rgba(239, 236, 231, 0.48);
    line-height: 1.45;
  }

  .site-footer__legal-link {
    color: rgba(239, 236, 231, 0.65);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .site-footer__legal-link:hover {
    color: #fff;
  }

  .site-footer__legal-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>