---
import FooterContactExplore from './FooterContactExplore.astro';
import { SITE } from '../site';

interface Props {
  /** When `baseOnly`, only the legal strip — use when Contact/Explore are inlined on the page (e.g. marine). */
  variant?: 'full' | 'baseOnly';
}

const { variant = 'full' } = Astro.props;
---

<footer class:list={['site-footer', variant === 'baseOnly' && 'site-footer--legal-only']}>
  {
    variant === 'full' && (
      <div class="u-container site-footer__main">
        <FooterContactExplore />
      </div>
    )
  }
  <div class="site-footer__base u-container">
    <p class="u-muted">Based in {SITE.locality}, {SITE.region}. Licensed &amp; insured.</p>
    <p class="u-muted">© {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: var(--space-xl) var(--space-lg);
    background: var(--footer-bg);
    border-top: none;
  }

  .site-footer--legal-only {
    padding-block: var(--footer-cta-section-gap) var(--space-lg);
  }

  .site-footer__main {
    display: flex;
    justify-content: center;
  }

  .site-footer__base {
    margin-top: var(--footer-cta-section-gap);
    padding-top: 0.65rem;
    border-top: 1px solid rgba(239, 236, 231, 0.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
  }

  .site-footer--legal-only .site-footer__base {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .site-footer__base p {
    margin: 0;
    font-size: 0.8125rem;
  }
</style>
