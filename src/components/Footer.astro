---
import { NAV_MAIN, NAV_SERVICES, SITE } from '../site';
import logoEagle from '../../assets/branding/logo-eagle-transparent.png';
import logoText from '../../assets/branding/logo-text-transparent.png';

const year = new Date().getFullYear();
const exploreLinks = [...NAV_SERVICES, ...NAV_MAIN];
---

<footer class="site-footer">
  <div class="u-container site-footer__inner">
    <div class="site-footer__grid">
      <div class="site-footer__col site-footer__col--brand">
        <a class="site-footer__brand" href="/" aria-label={`${SITE.shortName} home`}>
          <img
            class="site-footer__logo site-footer__logo--eagle"
            src={logoEagle.src}
            width={logoEagle.width}
            height={logoEagle.height}
            alt=""
            decoding="async"
          />
          <img
            class="site-footer__logo site-footer__logo--text"
            src={logoText.src}
            width={logoText.width}
            height={logoText.height}
            alt=""
            decoding="async"
          />
        </a>
        <span class="site-footer__brand-dash" aria-hidden="true"></span>
        <p class="site-footer__tagline">{SITE.tagline}</p>
        <ul class="site-footer__social" aria-label="Social">
          <li>
            <a
              class="site-footer__social-link"
              href={SITE.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Instagram (${SITE.instagramHandle})`}
            >
              <svg class="site-footer__social-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
                <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
                <circle cx="12" cy="12" r="4.25"></circle>
                <circle cx="17.25" cy="6.75" r="1.25" fill="currentColor" stroke="none"></circle>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <nav class="site-footer__col site-footer__col--explore" aria-label="Explore">
        <p class="site-footer__label">Explore</p>
        <ul class="site-footer__explore-list">
          {
            exploreLinks.map(({ href, label }) => (
              <li>
                <a class="site-footer__link" href={href}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col site-footer__col--contact">
        <p class="site-footer__label">Contact</p>
        <ul class="site-footer__contact-list">
          <li class="site-footer__contact-row">
            <svg class="site-footer__contact-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              ></path>
            </svg>
            <a class="site-footer__contact-link" href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a>
          </li>
          <li class="site-footer__contact-row">
            <svg class="site-footer__contact-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path>
              <path d="m22 6-10 7L2 6"></path>
            </svg>
            <a class="site-footer__contact-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </li>
          <li class="site-footer__contact-row">
            <svg class="site-footer__contact-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 21s7-4.35 7-11a7 7 0 1 0-14 0c0 6.65 7 11 7 11z"></path>
              <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
            <span class="site-footer__contact-text">{SITE.locality}, {SITE.region}</span>
          </li>
        </ul>
      </div>

      <div class="site-footer__col site-footer__col--cta">
        <p class="site-footer__label">Get started</p>
        <a class="site-footer__cta-primary" href="/contact">
          <span class="site-footer__cta-arrow" aria-hidden="true">→</span>
          Request service
        </a>
        <p class="site-footer__cta-secondary">
          Existing client?{' '}
          <a class="site-footer__cta-sms" href={`sms:${SITE.phoneTel}`}>Text us</a>
        </p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__legal site-footer__legal--copyright">
        © {year} {SITE.name}. All rights reserved.
      </p>
      <p class="site-footer__legal site-footer__legal--meta">
        Based in {SITE.locality}, {SITE.region}. Licensed &amp; insured.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    /* Above fixed marine/aviation/automotive hero stack (38 in `global.css`); below `.site-header` (50). */
    z-index: 39;
    margin-top: auto;
    padding-top: clamp(2rem, 6vw, 5rem);
    padding-bottom: max(clamp(1.25rem, 4vw, 2rem), env(safe-area-inset-bottom, 0px));
    background-color: var(--footer-bg);
    border-top: 1px solid rgba(239, 236, 231, 0.06);
  }

  .site-footer__inner {
    position: relative;
  }

  .site-footer__grid {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    padding-bottom: clamp(2rem, 6vw, 5rem);
    grid-template-columns: 1fr;
    grid-template-areas:
      'brand'
      'cta'
      'explore'
      'contact';
  }

  .site-footer__col--brand {
    grid-area: brand;
  }

  .site-footer__col--explore {
    grid-area: explore;
  }

  .site-footer__col--contact {
    grid-area: contact;
  }

  .site-footer__col--cta {
    grid-area: cta;
  }

  @media (max-width: 767px) {
    .site-footer__grid {
      justify-items: center;
    }

    .site-footer__col {
      text-align: center;
    }

    .site-footer__brand {
      justify-content: center;
    }

    .site-footer__brand-dash {
      margin-inline: auto;
    }

    .site-footer__tagline {
      margin-inline: auto;
    }

    .site-footer__social {
      justify-content: center;
    }

    .site-footer__explore-list {
      justify-items: center;
    }

    .site-footer__contact-row {
      justify-content: center;
      align-items: center;
    }

    .site-footer__bottom {
      align-items: center;
      text-align: center;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(1.75rem, 4vw, 3rem);
      row-gap: clamp(2rem, 5vw, 3rem);
      grid-template-areas:
        'brand cta'
        'explore contact';
      align-items: start;
    }

    .site-footer__col--cta {
      justify-self: end;
      text-align: right;
      width: 100%;
      max-width: 17rem;
    }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-areas: 'brand explore contact cta';
      column-gap: clamp(2rem, 4vw, 4rem);
      align-items: start;
    }

    .site-footer__col--cta {
      justify-self: end;
      text-align: right;
      width: 100%;
      max-width: 17rem;
    }
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: #fff;
  }

  .site-footer__brand:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .site-footer__logo {
    display: block;
    flex: 0 0 auto;
    height: auto;
  }

  .site-footer__logo--eagle {
    width: 2.65rem;
  }

  .site-footer__logo--text {
    width: clamp(7.5rem, 18vw, 9.5rem);
    margin-top: 0.08rem;
  }

  .site-footer__brand-dash {
    display: block;
    width: 2.75rem;
    height: 2px;
    margin-top: 0.85rem;
    border-radius: 1px;
    background: linear-gradient(90deg, rgba(196, 184, 150, 0.95), rgba(196, 184, 150, 0.35));
  }

  .site-footer__tagline {
    margin: 0.85rem 0 0;
    max-width: 18rem;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    line-height: 1.45;
    color: rgba(239, 236, 231, 0.82);
  }

  .site-footer__social {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    gap: 0.65rem;
  }

  .site-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.88);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .site-footer__social-link:hover {
    color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-footer__social-link:hover {
      transform: translateY(-1px);
    }
  }

  .site-footer__social-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .site-footer__social-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .site-footer__social-img {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
    object-fit: contain;
  }

  .site-footer__label {
    margin: 0 0 0.85rem;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    opacity: 0.92;
  }

  .site-footer__explore-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem 1.25rem;
  }

  @media (max-width: 767px) {
    .site-footer__explore-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 768px) {
    .site-footer__explore-list {
      grid-template-columns: 1fr;
    }
  }

  .site-footer__link {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    color: rgba(239, 236, 231, 0.88);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer__link:hover {
    color: #fff;
  }

  .site-footer__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .site-footer__contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .site-footer__contact-row {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .site-footer__contact-icon {
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.15rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .site-footer__contact-link {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    color: rgba(239, 236, 231, 0.92);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    transition: color 0.15s ease;
  }

  .site-footer__contact-link:hover {
    color: #fff;
  }

  .site-footer__contact-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .site-footer__contact-text {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    color: rgba(239, 236, 231, 0.82);
  }

  .site-footer__cta-primary {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    padding: 0.72rem 1.15rem;
    border: 1px solid rgba(196, 184, 150, 0.85);
    border-radius: 2px;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(239, 236, 231, 0.96);
    background: rgba(255, 255, 255, 0.03);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  @media (min-width: 768px) {
    .site-footer__cta-primary {
      width: auto;
      min-width: 11.5rem;
      justify-content: flex-end;
    }

    .site-footer__col--cta .site-footer__cta-primary {
      margin-inline-start: auto;
    }
  }

  .site-footer__cta-primary:hover {
    border-color: var(--color-accent);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-footer__cta-primary:hover {
      transform: translateY(-1px);
    }
  }

  .site-footer__cta-primary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .site-footer__cta-arrow {
    font-weight: 600;
    opacity: 0.95;
  }

  .site-footer__cta-secondary {
    margin: 0.85rem 0 0;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: rgba(239, 236, 231, 0.72);
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .site-footer__cta-secondary {
      text-align: right;
    }
  }

  .site-footer__cta-sms {
    color: rgba(239, 236, 231, 0.92);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    transition: color 0.15s ease;
  }

  .site-footer__cta-sms:hover {
    color: #fff;
  }

  .site-footer__cta-sms:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    padding-top: clamp(1rem, 2.5vw, 1.35rem);
    border-top: 1px solid rgba(239, 236, 231, 0.08);
  }

  @media (min-width: 768px) {
    .site-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
  }

  .site-footer__legal {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: rgba(239, 236, 231, 0.52);
    line-height: 1.45;
  }
</style>
