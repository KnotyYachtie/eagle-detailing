---
import { SITE, NAV } from '../site';

interface Props {
  /** Optional extra class on the grid wrapper (e.g. marine reach spacing). */
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['footer-cta', className]}>
  <div>
    <p class="footer-cta__heading">Contact</p>
    <p>
      <a href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a>
    </p>
    <p>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
    <p>
      <a href={SITE.instagramUrl} target="_blank" rel="noopener noreferrer">{SITE.instagramHandle}</a>
    </p>
  </div>
  <div>
    <p class="footer-cta__heading">Explore</p>
    <ul class="footer-cta__links">
      {
        NAV.map(({ href, label }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .footer-cta {
    display: grid;
    gap: var(--footer-cta-section-gap);
    grid-template-columns: 1fr;
    text-align: center;
    justify-items: center;
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }

  @media (min-width: 720px) {
    .footer-cta {
      grid-template-columns: auto auto;
      justify-content: center;
      column-gap: clamp(2.5rem, 10vw, 5rem);
      row-gap: var(--footer-cta-section-gap);
    }
  }

  .footer-cta__heading {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-sm);
  }

  .footer-cta__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-cta__links li {
    margin-bottom: 0.35rem;
  }

  .footer-cta a {
    font-size: 0.9375rem;
    color: var(--color-cream-muted);
    text-decoration: none;
  }

  .footer-cta p {
    margin: 0 0 0.35rem;
  }

  .footer-cta a:hover,
  .footer-cta a:focus-visible {
    color: #fff;
  }
</style>
