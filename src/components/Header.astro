---
import { NAV_ABOUT_CHILDREN, NAV_MAIN, NAV_SERVICES, SITE } from '../site';
import eagleSvgRaw from '../../assets/eagle.svg?raw';

interface Props {
  currentPath?: string;
  transparent?: boolean;
}

const { currentPath = Astro.url.pathname, transparent = false } = Astro.props;

const servicesOpen = NAV_SERVICES.some(({ href }) => currentPath === href);
const aboutOpen =
  NAV_ABOUT_CHILDREN.some(({ href }) => currentPath === href) || currentPath === '/about';

/* Inline mark so paths use currentColor; strip root sizing so header CSS controls width */
const eagleForHeader = eagleSvgRaw.replace(
  /<svg[\s\S]*?>/,
  '<svg class="site-header__eagle-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 503 408" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true">'
);
---

<header
  class:list={['site-header', transparent && 'site-header--transparent']}
  data-transparent={transparent ? 'true' : 'false'}
>
  <div class="site-header__inner u-container">
    <a class="site-header__brand" href="/" aria-label={`${SITE.shortName} home`}>
      {
        transparent ? (
          <span class="site-header__logo site-header__logo--eagle" set:html={eagleForHeader} />
        ) : (
          <img
            class="site-header__logo"
            src="/logo-light.png"
            alt=""
            width="56"
            height="67"
            loading="eager"
            decoding="async"
          />
        )
      }
      <span class="site-header__brand-copy">
        <span class="site-header__wordmark">{SITE.shortName}</span>
        <span class="site-header__region">South Florida</span>
      </span>
    </a>
    <nav class="site-header__nav" id="site-nav" aria-label="Primary">
      <ul class="site-header__list">
        <li class="site-header__group" data-nav-group="services" data-services-current={servicesOpen ? 'true' : 'false'}>
          <button
            type="button"
            class:list={[
              'site-header__link',
              'site-header__subtrigger',
              servicesOpen && 'is-active',
            ]}
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-services-sub"
            id="nav-services-trigger"
            data-services-toggle
          >
            Services
          </button>
          <ul class="site-header__sublist" id="nav-services-sub" role="list">
            {
              NAV_SERVICES.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class:list={['site-header__link', 'site-header__sublink', currentPath === href && 'is-active']}
                    data-nav-link
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        <li class="site-header__group" data-nav-group="about" data-about-current={aboutOpen ? 'true' : 'false'}>
          <button
            type="button"
            class:list={['site-header__link', 'site-header__subtrigger', aboutOpen && 'is-active']}
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-about-sub"
            id="nav-about-trigger"
            data-about-toggle
          >
            About
          </button>
          <ul class="site-header__sublist" id="nav-about-sub" role="list">
            {
              NAV_ABOUT_CHILDREN.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class:list={['site-header__link', 'site-header__sublink', currentPath === href && 'is-active']}
                    data-nav-link
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {
          NAV_MAIN.map(({ href, label }) => (
            <li>
              <a href={href} class:list={['site-header__link', currentPath === href && 'is-active']} data-nav-link>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const mq = window.matchMedia('(max-width: 960px)');

  const nav = document.getElementById('site-nav');
  const links = document.querySelectorAll('[data-nav-link]');
  const servicesGroup = document.querySelector('[data-nav-group="services"]');
  const aboutGroup = document.querySelector('[data-nav-group="about"]');
  const servicesBtn = document.querySelector('[data-services-toggle]');
  const aboutBtn = document.querySelector('[data-about-toggle]');

  function setServicesExpanded(open: boolean) {
    if (!servicesGroup || !servicesBtn) return;
    servicesGroup.classList.toggle('is-services-open', open);
    servicesBtn.setAttribute('aria-expanded', String(open));
    if (open && aboutGroup && aboutBtn) {
      aboutGroup.classList.remove('is-about-open');
      aboutBtn.setAttribute('aria-expanded', 'false');
    }
  }

  function setAboutExpanded(open: boolean) {
    if (!aboutGroup || !aboutBtn) return;
    aboutGroup.classList.toggle('is-about-open', open);
    aboutBtn.setAttribute('aria-expanded', String(open));
    if (open && servicesGroup && servicesBtn) {
      servicesGroup.classList.remove('is-services-open');
      servicesBtn.setAttribute('aria-expanded', 'false');
    }
  }

  function collapseSubmenusIfMobile() {
    if (!mq.matches) return;
    setServicesExpanded(false);
    setAboutExpanded(false);
  }

  links.forEach((l) =>
    l.addEventListener('click', () => {
      nav?.classList.remove('is-open');
      collapseSubmenusIfMobile();
    })
  );

  document.addEventListener(
    'pointerdown',
    (e) => {
      if (!mq.matches) return;
      const header = document.querySelector('.site-header');
      if (!header || !(e.target instanceof Node)) return;
      if (!header.contains(e.target)) collapseSubmenusIfMobile();
    },
    true
  );

  if (servicesGroup && servicesBtn) {
    servicesBtn.addEventListener('click', () => {
      if (!mq.matches) return;
      const next = !servicesGroup.classList.contains('is-services-open');
      setServicesExpanded(next);
    });
  }

  if (aboutGroup && aboutBtn) {
    aboutBtn.addEventListener('click', () => {
      if (!mq.matches) return;
      const next = !aboutGroup.classList.contains('is-about-open');
      setAboutExpanded(next);
    });
  }

  mq.addEventListener('change', (e) => {
    if (!e.matches) {
      setServicesExpanded(false);
      setAboutExpanded(false);
    } else {
      nav?.classList.remove('is-open');
      collapseSubmenusIfMobile();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    display: flex;
    align-items: center;
    box-sizing: border-box;
    background: rgba(16, 33, 53, 0.78);
    backdrop-filter: var(--glass-blur-header);
    -webkit-backdrop-filter: var(--glass-blur-header);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  /*
    Sticky (same as solid header) so logo, wordmark, and nav stay visible while scrolling.
    Home hero still uses negative margin so the photograph continues under this bar.
  */
  .site-header--transparent {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
    box-shadow: none;
  }

  /* Keep chrome readable over the hero without a tinted “banner” bar */
  .site-header--transparent .site-header__logo,
  .site-header--transparent .site-header__logo--eagle .site-header__eagle-svg {
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.4));
  }

  .site-header--transparent .site-header__wordmark {
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.45);
  }

  .site-header--transparent .site-header__link {
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    width: 100%;
    /* Extra inset so logo + wordmark aren’t flush to the container edge */
    padding-inline: clamp(1.25rem, 4vw, 2.25rem);
    /* Sit above vertical center — full `--header-h` on mobile reads “low” under the island */
    transform: translateY(-0.38rem);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-cream);
    margin-right: auto;
    transform: translateY(-0.12rem);
    opacity: 0.82;
    transition: opacity 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .site-header__brand:hover {
    color: #fff;
    opacity: 1;
  }

  .site-header__logo {
    width: clamp(50px, 6.25vw, 64px);
    height: auto;
  }

  .site-header__logo--eagle {
    display: block;
    flex-shrink: 0;
    color: #fff;
    line-height: 0;
  }

  .site-header__eagle-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-header__wordmark {
    font-family: var(--font-display);
    font-size: clamp(1.08rem, 2.45vw, 1.22rem);
    font-weight: 500;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .site-header__brand-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.05rem;
    line-height: 1;
  }

  .site-header__region {
    font-family: var(--font-ui);
    font-size: clamp(0.62rem, 1.12vw, 0.72rem);
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(239, 236, 231, 0.66);
    line-height: 1.2;
  }

  .site-header__nav {
    display: flex;
    justify-content: flex-end;
    flex: 0 0 auto;
    margin-left: auto;
    transform: translateY(-0.14rem);
  }

  .site-header__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    justify-content: flex-end;
  }

  .site-header__link {
    font-size: var(--header-nav-link-size);
    font-weight: 500;
    letter-spacing: var(--header-nav-link-tracking);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-cream-muted);
    white-space: nowrap;
    /* Kill WebKit’s default gray/dark tap sheet only; keep our own :hover / :active feedback below */
    -webkit-tap-highlight-color: transparent;
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: #fff;
  }

  .site-header__group {
    position: relative;
  }

  /* Reset button chrome only — do not use `font: inherit` or it overrides .site-header__link sizing */
  .site-header__subtrigger {
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    border: none;
    background: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-ui);
    text-align: inherit;
    line-height: inherit;
  }

  .site-header__subtrigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .site-header__subtrigger:focus:not(:focus-visible) {
    outline: none;
  }

  .site-header__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 961px) {
    /* Floating submenu: no card, text only, drops in under Services */
    .site-header__sublist {
      position: absolute;
      top: calc(100% + 0.25rem);
      left: 0;
      transform: none;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
      padding: 0;
      margin: 0;
      min-width: max-content;
      background: none;
      border: none;
      border-radius: 0;
      box-shadow: none;
      visibility: hidden;
      pointer-events: none;
      /* Stay “visible” until row fades so exit motion can play (mirror of enter) */
      transition: visibility 0s linear 0.38s;
      z-index: 60;
    }

    /* Invisible hover bridge Services ↔ links */
    .site-header__sublist::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: -0.65rem;
      height: 0.65rem;
    }

    .site-header__group:hover .site-header__sublist,
    .site-header__group:focus-within .site-header__sublist {
      visibility: visible;
      pointer-events: auto;
      transition: visibility 0s;
    }

    .site-header__sublist > li {
      margin: 0;
      opacity: 0;
      transform: translateY(-0.45rem);
      transition:
        opacity 0.22s var(--ease-out),
        transform 0.26s var(--ease-out);
      transition-delay: 0s;
    }

    /* Enter: top → bottom */
    .site-header__group:hover .site-header__sublist > li,
    .site-header__group:focus-within .site-header__sublist > li {
      opacity: 1;
      transform: translateY(0);
    }

    .site-header__group:hover .site-header__sublist > li:nth-child(1),
    .site-header__group:focus-within .site-header__sublist > li:nth-child(1) {
      transition-delay: 0.04s;
    }

    .site-header__group:hover .site-header__sublist > li:nth-child(2),
    .site-header__group:focus-within .site-header__sublist > li:nth-child(2) {
      transition-delay: 0.1s;
    }

    .site-header__group:hover .site-header__sublist > li:nth-child(3),
    .site-header__group:focus-within .site-header__sublist > li:nth-child(3) {
      transition-delay: 0.16s;
    }

    /* Exit: bottom → top (reverse stagger) */
    .site-header__group:not(:hover):not(:focus-within) .site-header__sublist > li:nth-child(1) {
      transition-delay: 0.16s;
    }

    .site-header__group:not(:hover):not(:focus-within) .site-header__sublist > li:nth-child(2) {
      transition-delay: 0.08s;
    }

    .site-header__group:not(:hover):not(:focus-within) .site-header__sublist > li:nth-child(3) {
      transition-delay: 0s;
    }

    .site-header__sublist .site-header__sublink {
      display: block;
      padding: 0.15rem 0;
      font-size: var(--header-nav-link-size);
      font-weight: 500;
      letter-spacing: var(--header-nav-link-tracking);
      line-height: 1.35;
      white-space: nowrap;
      text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
    }

    .site-header--transparent .site-header__sublist .site-header__sublink {
      text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
    }
  }

  @media (min-width: 961px) and (prefers-reduced-motion: reduce) {
    .site-header__sublist {
      transition: none;
    }

    .site-header__sublist > li {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .site-header__group:not(:hover):not(:focus-within) .site-header__sublist > li {
      transition-delay: 0s;
    }
  }

  @media (max-width: 960px) {
    .site-header {
      height: auto;
      min-height: var(--header-h);
      align-items: flex-start;
      padding-bottom: 0.2rem;
    }

    .site-header__brand-copy {
      display: flex;
    }

    .site-header__wordmark {
      font-size: clamp(0.9rem, 2.75vw, 1.06rem);
    }

    .site-header__region {
      font-size: clamp(0.58rem, 2vw, 0.7rem);
    }

    .site-header__logo {
      width: clamp(40px, 8.5vw, 50px);
    }

    .site-header__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0.35rem 0;
      padding-block: 0.15rem 0.05rem;
      transform: translateY(
        calc(-0.28rem - min(10px, max(0px, var(--header-safe-pad) * 0.22)))
      );
    }

    .site-header__brand {
      margin-right: 0;
      width: 100%;
      transform: translateY(0);
      justify-content: flex-start;
    }

    .site-header__nav {
      position: static;
      inset: auto;
      flex: none;
      width: 100%;
      min-width: 0;
      margin-left: 0;
      display: flex;
      justify-content: stretch;
      align-items: stretch;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      background: none;
      padding: 0;
      overflow: visible;
    }

    .site-header__list {
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: flex-start;
      align-items: stretch;
      gap: 0.12rem 0;
      width: 100%;
      max-width: 100%;
    }

    .site-header__list > li {
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }

    .site-header__group {
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }

    .site-header__link,
    .site-header__subtrigger.site-header__link {
      font-size: var(--header-nav-link-size-mobile);
      letter-spacing: var(--header-nav-link-tracking-mobile);
      padding: 0.14rem 0;
      text-align: right;
      width: 100%;
      display: block;
      box-sizing: border-box;
    }

    /*
      In-flow row of sublinks; items ease in horizontally (stagger).
      `--header-bar` on mobile reserves vertical space for hero bleed.
    */
    .site-header__sublist {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
      gap: 0.35rem 0.85rem;
      position: static;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      max-height: 0;
      opacity: 0;
      visibility: hidden;
      overflow: hidden;
      margin: 0;
      padding: 0;
      background: none;
      border: none;
      box-shadow: none;
      transform: none;
      transition:
        max-height 0.3s var(--ease-out),
        opacity 0.22s var(--ease-out),
        visibility 0s linear 0.3s;
    }

    .site-header__group.is-services-open .site-header__sublist,
    .site-header__group.is-about-open .site-header__sublist {
      max-height: 3.5rem;
      opacity: 1;
      visibility: visible;
      margin-top: 0.12rem;
      padding-bottom: 0.12rem;
      transition:
        max-height 0.3s var(--ease-out),
        opacity 0.22s var(--ease-out),
        visibility 0s;
    }

    .site-header__sublist > li {
      margin: 0;
      opacity: 0;
      transform: translateX(0.65rem);
      transition:
        opacity 0.2s var(--ease-out),
        transform 0.24s var(--ease-out);
      transition-delay: 0s;
    }

    .site-header__group.is-services-open .site-header__sublist > li,
    .site-header__group.is-about-open .site-header__sublist > li {
      opacity: 1;
      transform: translateX(0);
    }

    .site-header__group.is-services-open .site-header__sublist > li:nth-child(1),
    .site-header__group.is-about-open .site-header__sublist > li:nth-child(1) {
      transition-delay: 0.04s;
    }

    .site-header__group.is-services-open .site-header__sublist > li:nth-child(2),
    .site-header__group.is-about-open .site-header__sublist > li:nth-child(2) {
      transition-delay: 0.1s;
    }

    .site-header__group.is-services-open .site-header__sublist > li:nth-child(3),
    .site-header__group.is-about-open .site-header__sublist > li:nth-child(3) {
      transition-delay: 0.16s;
    }

    .site-header__sublist .site-header__sublink {
      display: inline-block;
      padding: 0.08rem 0;
      font-size: var(--header-nav-link-size-mobile);
      font-weight: 500;
      letter-spacing: var(--header-nav-link-tracking-mobile);
      line-height: 1.3;
      white-space: nowrap;
      text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
    }

    .site-header--transparent .site-header__sublist .site-header__sublink {
      text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
    }
  }

  @media (max-width: 960px) and (prefers-reduced-motion: reduce) {
    .site-header__sublist {
      transition: none;
    }

    .site-header__sublist > li {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
