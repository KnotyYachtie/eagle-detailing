---
import { NAV_ABOUT_CHILDREN, NAV_MAIN, NAV_SERVICES, SITE } from '../site';
import logoLockup from '../../assets/branding/logo-lockup-transparent.png';

interface Props {
  currentPath?: string;
  transparent?: boolean;
}

const { currentPath = Astro.url.pathname, transparent = false } = Astro.props;

const servicesOpen = NAV_SERVICES.some(({ href }) => currentPath === href);
const aboutOpen =
  NAV_ABOUT_CHILDREN.some(({ href }) => currentPath === href) || currentPath === '/about';
---

<header
  class:list={['site-header', transparent && 'site-header--transparent']}
  data-transparent={transparent ? 'true' : 'false'}
>
  <div class="site-header__inner u-container">
    <a class="site-header__brand" href="/" aria-label={`${SITE.shortName} home`}>
      <img
        class="site-header__logo site-header__logo--lockup"
        src={logoLockup.src}
        width={logoLockup.width}
        height={logoLockup.height}
        alt=""
        decoding="async"
      />
    </a>
    <nav class="site-header__nav" id="site-nav" aria-label="Primary">
      <ul class="site-header__list">
        <li class="site-header__group" data-nav-group="services" data-services-current={servicesOpen ? 'true' : 'false'}>
          <button
            type="button"
            class:list={[
              'site-header__link',
              'site-header__subtrigger',
              servicesOpen && 'is-active',
            ]}
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-services-sub"
            id="nav-services-trigger"
            data-services-toggle
          >
            Services
          </button>
          <ul class="site-header__sublist" id="nav-services-sub" role="list">
            {
              NAV_SERVICES.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class:list={['site-header__link', 'site-header__sublink', currentPath === href && 'is-active']}
                    data-nav-link
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        <li class="site-header__group" data-nav-group="about" data-about-current={aboutOpen ? 'true' : 'false'}>
          <button
            type="button"
            class:list={['site-header__link', 'site-header__subtrigger', aboutOpen && 'is-active']}
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-about-sub"
            id="nav-about-trigger"
            data-about-toggle
          >
            About
          </button>
          <ul class="site-header__sublist" id="nav-about-sub" role="list">
            {
              NAV_ABOUT_CHILDREN.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class:list={['site-header__link', 'site-header__sublink', currentPath === href && 'is-active']}
                    data-nav-link
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {
          NAV_MAIN.map(({ href, label }) => (
            <li>
              <a href={href} class:list={['site-header__link', currentPath === href && 'is-active']} data-nav-link>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const mql = window.matchMedia('(max-width: 960px)');

  function qServices() {
    return {
      group: document.querySelector('[data-nav-group="services"]'),
      trigger: document.querySelector<HTMLButtonElement>('[data-services-toggle]'),
    };
  }

  function qAbout() {
    return {
      group: document.querySelector('[data-nav-group="about"]'),
      trigger: document.querySelector<HTMLButtonElement>('[data-about-toggle]'),
    };
  }

  function setServicesExpanded(open: boolean) {
    const s = qServices();
    const a = qAbout();
    if (!s.group || !s.trigger) return;
    s.group.classList.toggle('is-services-open', open);
    s.trigger.setAttribute('aria-expanded', String(open));
    if (open && a.group && a.trigger) {
      a.group.classList.remove('is-about-open');
      a.trigger.setAttribute('aria-expanded', 'false');
    }
  }

  function setAboutExpanded(open: boolean) {
    const a = qAbout();
    const s = qServices();
    if (!a.group || !a.trigger) return;
    a.group.classList.toggle('is-about-open', open);
    a.trigger.setAttribute('aria-expanded', String(open));
    if (open && s.group && s.trigger) {
      s.group.classList.remove('is-services-open');
      s.trigger.setAttribute('aria-expanded', 'false');
    }
  }

  function collapseSubmenusIfMobile() {
    if (!mql.matches) return;
    setServicesExpanded(false);
    setAboutExpanded(false);
  }

  function eventTargetToElement(t: EventTarget | null): Element | null {
    if (t == null) return null;
    if (t instanceof Element) return t;
    if (t instanceof Node) return t.parentElement;
    return null;
  }

  /**
   * After Astro client navigations, the old header is replaced but this script is not re-run, so
   * per-button listeners and cached queryHandles point at detached nodes. One-time document-level
   * delegation + fresh querySelector in setters keeps Services/About toggles and outside-dismiss.
   */
  const w = window as unknown as { __eagleHeaderNavInit?: boolean };
  if (!w.__eagleHeaderNavInit) {
    w.__eagleHeaderNavInit = true;

    document.addEventListener(
      'click',
      (e) => {
        const t = eventTargetToElement(e.target);
        if (!t) return;

        const servicesBtn = t.closest('[data-services-toggle]');
        if (servicesBtn) {
          if (!mql.matches) return;
          e.preventDefault();
          const g = servicesBtn.closest('[data-nav-group="services"]');
          if (!g) return;
          const next = !g.classList.contains('is-services-open');
          setServicesExpanded(next);
          return;
        }

        const aboutBtn = t.closest('[data-about-toggle]');
        if (aboutBtn) {
          if (!mql.matches) return;
          e.preventDefault();
          const g = aboutBtn.closest('[data-nav-group="about"]');
          if (!g) return;
          const next = !g.classList.contains('is-about-open');
          setAboutExpanded(next);
          return;
        }

        if (t.closest('header.site-header [data-nav-link]')) {
          document.getElementById('site-nav')?.classList.remove('is-open');
          collapseSubmenusIfMobile();
        }
      },
      true
    );

    document.addEventListener(
      'pointerdown',
      (e) => {
        if (!mql.matches) return;
        const t = eventTargetToElement(e.target);
        if (!t) return;
        if (t.closest('header.site-header')) return;
        collapseSubmenusIfMobile();
      },
      true
    );

    mql.addEventListener('change', (e) => {
      if (!e.matches) {
        setServicesExpanded(false);
        setAboutExpanded(false);
      } else {
        document.getElementById('site-nav')?.classList.remove('is-open');
        collapseSubmenusIfMobile();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: auto;
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding-top: max(0.45rem, env(safe-area-inset-top, 0px));
    padding-bottom: 0.35rem;
    /* Flat ink bar when routes opt out of transparent chrome (e.g. `/contact`) — no lighter glass slab */
    background: #050a14;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
    box-shadow: none;
  }

  /*
    Sticky (same as solid header) so logo, wordmark, and nav stay visible while scrolling.
    Home hero still uses negative margin so the photograph continues under this bar.
  */
  .site-header--transparent {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
    box-shadow: none;
  }

  /* Brand lockup — vertical stacked transparent PNG over hero or flat ink bar */
  .site-header__logo--lockup {
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.4));
  }

  .site-header--transparent .site-header__link {
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    width: 100%;
    /* Extra inset so logo + wordmark aren’t flush to the container edge */
    padding-inline: clamp(1.25rem, 4vw, 2.25rem);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    margin-right: auto;
    opacity: 0.92;
    transition: opacity 0.2s var(--ease-out);
  }

  .site-header__brand:hover {
    opacity: 1;
  }

  .site-header__logo {
    display: block;
    height: auto;
    flex-shrink: 0;
  }

  .site-header__logo--lockup {
    width: var(--header-lockup-w);
  }

  .site-header__nav {
    display: flex;
    justify-content: flex-end;
    flex: 0 0 auto;
    margin-left: auto;
    align-self: center;
  }

  .site-header__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    justify-content: flex-end;
  }

  .site-header__link {
    font-size: var(--header-nav-link-size);
    font-weight: 500;
    letter-spacing: var(--header-nav-link-tracking);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-cream-muted);
    white-space: nowrap;
    /* Kill WebKit’s default gray/dark tap sheet only; keep our own :hover / :active feedback below */
    -webkit-tap-highlight-color: transparent;
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: #fff;
  }

  .site-header__group {
    position: relative;
  }

  /* Reset button chrome only — do not use `font: inherit` or it overrides .site-header__link sizing */
  .site-header__subtrigger {
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    border: none;
    background: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-ui);
    text-align: inherit;
    line-height: inherit;
  }

  .site-header__subtrigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .site-header__subtrigger:focus:not(:focus-visible) {
    outline: none;
  }

  .site-header__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 961px) {
    /* Floating submenu: no card, text only, drops in under Services */
    .site-header__sublist {
      position: absolute;
      top: calc(100% + 0.25rem);
      left: 0;
      transform: none;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
      padding: 0;
      margin: 0;
      min-width: max-content;
      background: none;
      border: none;
      border-radius: 0;
      box-shadow: none;
      visibility: hidden;
      pointer-events: none;
      /* Stay “visible” until row fades so exit motion can play (mirror of enter) */
      transition: visibility 0s linear 0.38s;
      z-index: 60;
    }

    /* Invisible hover bridge Services ↔ links */
    .site-header__sublist::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: -0.65rem;
      height: 0.65rem;
    }

    .site-header__group:hover .site-header__sublist,
    .site-header__group:focus-within .site-header__sublist {
      visibility: visible;
      pointer-events: auto;
      transition: visibility 0s;
    }

    .site-header__sublist > li {
      margin: 0;
      opacity: 0;
      transform: translateY(-0.45rem);
      transition:
        opacity 0.22s var(--ease-out),
        transform 0.26s var(--ease-out);
      transition-delay: 0s;
    }

    /* Enter: top → bottom */
    .site-header__group:hover .site-header__sublist > li,
    .site-header__group:focus-within .site-header__sublist > li {
      opacity: 1;
      transform: translateY(0);
    }

    .site-header__group:hover .site-header__sublist > li:nth-child(1),
    .site-header__group:focus-within .site-header__sublist > li:nth-child(1) {
      transition-delay: 0.04s;
    }

    .site-header__group:hover .site-header__sublist > li:nth-child(2),
    .site-header__group:focus-within .site-header__sublist > li:nth-child(2) {
      transition-delay: 0.1s;
    }

    .site-header__group:hover .site-header__sublist > li:nth-child(3),
    .site-header__group:focus-within .site-header__sublist > li:nth-child(3) {
      transition-delay: 0.16s;
    }

    /* Exit: bottom → top (reverse stagger) */
    .site-header__group:not(:hover):not(:focus-within) .site-header__sublist > li:nth-child(1) {
      transition-delay: 0.16s;
    }

    .site-header__group:not(:hover):not(:focus-within) .site-header__sublist > li:nth-child(2) {
      transition-delay: 0.08s;
    }

    .site-header__group:not(:hover):not(:focus-within) .site-header__sublist > li:nth-child(3) {
      transition-delay: 0s;
    }

    .site-header__sublist .site-header__sublink {
      display: block;
      padding: 0.15rem 0;
      font-size: var(--header-nav-link-size);
      font-weight: 500;
      letter-spacing: var(--header-nav-link-tracking);
      line-height: 1.35;
      white-space: nowrap;
      text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
    }

    .site-header--transparent .site-header__sublist .site-header__sublink {
      text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
    }
  }

  @media (min-width: 961px) and (prefers-reduced-motion: reduce) {
    .site-header__sublist {
      transition: none;
    }

    .site-header__sublist > li {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .site-header__group:not(:hover):not(:focus-within) .site-header__sublist > li {
      transition-delay: 0s;
    }
  }

  @media (max-width: 960px) {
    .site-header {
      height: auto;
      min-height: var(--header-h);
      align-items: flex-start;
      /* Safe area + extra inset so the taller lockup clears the notch */
      padding-top: calc(var(--header-safe-pad) + 0.35rem);
      padding-bottom: 0.2rem;
    }

    .site-header__logo--lockup {
      width: var(--header-lockup-w);
    }

    .site-header__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0.1rem 0;
      padding-block: 0.15rem 0.08rem;
    }

    .site-header__brand {
      margin-right: 0;
      width: 100%;
      justify-content: flex-start;
      padding-top: 0.1rem;
    }

    .site-header__nav {
      position: static;
      inset: auto;
      flex: none;
      width: 100%;
      min-width: 0;
      /* Pull the link stack up toward the brand only (doesn’t move the wordmark into the safe area) */
      margin: -0.4rem 0 0 0;
      display: flex;
      justify-content: stretch;
      align-items: stretch;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      background: none;
      padding: 0;
      overflow: visible;
    }

    .site-header__list {
      flex-direction: column;
      flex-wrap: nowrap;
      justify-content: flex-start;
      align-items: stretch;
      gap: 0.12rem 0;
      width: 100%;
      max-width: 100%;
    }

    .site-header__list > li {
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }

    .site-header__group {
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }

    .site-header__link,
    .site-header__subtrigger.site-header__link {
      font-size: var(--header-nav-link-size-mobile);
      letter-spacing: var(--header-nav-link-tracking-mobile);
      padding: 0.14rem 0;
      text-align: right;
      width: 100%;
      display: block;
      box-sizing: border-box;
    }

    /*
      In-flow row of sublinks; items ease in horizontally (stagger).
      `--header-bar` on mobile reserves vertical space for hero bleed.
    */
    .site-header__sublist {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
      gap: 0.35rem 0.85rem;
      position: static;
      width: 100%;
      min-width: 0;
      max-width: 100%;
      max-height: 0;
      opacity: 0;
      visibility: hidden;
      overflow: hidden;
      margin: 0;
      padding: 0;
      background: none;
      border: none;
      box-shadow: none;
      transform: none;
      transition:
        max-height 0.3s var(--ease-out),
        opacity 0.22s var(--ease-out),
        visibility 0s linear 0.3s;
    }

    .site-header__group.is-services-open .site-header__sublist,
    .site-header__group.is-about-open .site-header__sublist {
      max-height: 3.5rem;
      opacity: 1;
      visibility: visible;
      margin-top: 0.12rem;
      padding-bottom: 0.12rem;
      transition:
        max-height 0.3s var(--ease-out),
        opacity 0.22s var(--ease-out),
        visibility 0s;
    }

    .site-header__sublist > li {
      margin: 0;
      opacity: 0;
      transform: translateX(0.65rem);
      transition:
        opacity 0.2s var(--ease-out),
        transform 0.24s var(--ease-out);
      transition-delay: 0s;
    }

    .site-header__group.is-services-open .site-header__sublist > li,
    .site-header__group.is-about-open .site-header__sublist > li {
      opacity: 1;
      transform: translateX(0);
    }

    .site-header__group.is-services-open .site-header__sublist > li:nth-child(1),
    .site-header__group.is-about-open .site-header__sublist > li:nth-child(1) {
      transition-delay: 0.04s;
    }

    .site-header__group.is-services-open .site-header__sublist > li:nth-child(2),
    .site-header__group.is-about-open .site-header__sublist > li:nth-child(2) {
      transition-delay: 0.1s;
    }

    .site-header__group.is-services-open .site-header__sublist > li:nth-child(3),
    .site-header__group.is-about-open .site-header__sublist > li:nth-child(3) {
      transition-delay: 0.16s;
    }

    .site-header__sublist .site-header__sublink {
      display: inline-block;
      padding: 0.08rem 0;
      font-size: var(--header-nav-link-size-mobile);
      font-weight: 500;
      letter-spacing: var(--header-nav-link-tracking-mobile);
      line-height: 1.3;
      white-space: nowrap;
      text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
    }

    .site-header--transparent .site-header__sublist .site-header__sublink {
      text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
    }
  }

  @media (max-width: 960px) and (prefers-reduced-motion: reduce) {
    .site-header__sublist {
      transition: none;
    }

    .site-header__sublist > li {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
