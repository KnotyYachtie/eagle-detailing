---
import { NAV_ABOUT_CHILDREN, NAV_MAIN, NAV_SERVICES, SITE } from '../site';
import eagleSvgRaw from '../../assets/eagle.svg?raw';

interface Props {
  currentPath?: string;
  transparent?: boolean;
}

const { currentPath = Astro.url.pathname, transparent = false } = Astro.props;

const servicesOpen = NAV_SERVICES.some(({ href }) => currentPath === href);
const aboutOpen =
  NAV_ABOUT_CHILDREN.some(({ href }) => currentPath === href) || currentPath === '/about';

/* Inline mark so paths use currentColor; strip root sizing so header CSS controls width */
const eagleForHeader = eagleSvgRaw.replace(
  /<svg[\s\S]*?>/,
  '<svg class="site-header__eagle-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 503 408" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true">'
);
---

<header
  class:list={['site-header', transparent && 'site-header--transparent']}
  data-transparent={transparent ? 'true' : 'false'}
>
  <div class="site-header__inner u-container">
    <a class="site-header__brand" href="/" aria-label={`${SITE.shortName} home`}>
      {
        transparent ? (
          <span class="site-header__logo site-header__logo--eagle" set:html={eagleForHeader} />
        ) : (
          <img
            class="site-header__logo"
            src="/logo-light.png"
            alt=""
            width="56"
            height="67"
            loading="eager"
            decoding="async"
          />
        )
      }
      <span class="site-header__brand-copy">
        <span class="site-header__wordmark">{SITE.shortName}</span>
        <span class="site-header__region">South Florida</span>
      </span>
    </a>
    <button
      type="button"
      class="site-header__menu-btn"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      Menu
    </button>
    <nav class="site-header__nav" id="site-nav" aria-label="Primary">
      <ul class="site-header__list">
        <li class="site-header__group" data-nav-group="services" data-services-current={servicesOpen ? 'true' : 'false'}>
          <button
            type="button"
            class:list={[
              'site-header__link',
              'site-header__subtrigger',
              servicesOpen && 'is-active',
            ]}
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-services-sub"
            id="nav-services-trigger"
            data-services-toggle
          >
            Services
          </button>
          <ul class="site-header__sublist" id="nav-services-sub" role="list">
            {
              NAV_SERVICES.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class:list={['site-header__link', 'site-header__sublink', currentPath === href && 'is-active']}
                    data-nav-link
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        <li class="site-header__group" data-nav-group="about" data-about-current={aboutOpen ? 'true' : 'false'}>
          <button
            type="button"
            class:list={['site-header__link', 'site-header__subtrigger', aboutOpen && 'is-active']}
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="nav-about-sub"
            id="nav-about-trigger"
            data-about-toggle
          >
            About
          </button>
          <ul class="site-header__sublist" id="nav-about-sub" role="list">
            {
              NAV_ABOUT_CHILDREN.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class:list={['site-header__link', 'site-header__sublink', currentPath === href && 'is-active']}
                    data-nav-link
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>
        {
          NAV_MAIN.map(({ href, label }) => (
            <li>
              <a href={href} class:list={['site-header__link', currentPath === href && 'is-active']} data-nav-link>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const mq = window.matchMedia('(max-width: 960px)');

  const btn = document.querySelector('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');
  const links = document.querySelectorAll('[data-nav-link]');
  const servicesGroup = document.querySelector('[data-nav-group="services"]');
  const aboutGroup = document.querySelector('[data-nav-group="about"]');
  const servicesBtn = document.querySelector('[data-services-toggle]');
  const aboutBtn = document.querySelector('[data-about-toggle]');

  function setServicesExpanded(open: boolean) {
    if (!servicesGroup || !servicesBtn) return;
    servicesGroup.classList.toggle('is-services-open', open);
    servicesBtn.setAttribute('aria-expanded', String(open));
    if (open && aboutGroup && aboutBtn) {
      aboutGroup.classList.remove('is-about-open');
      aboutBtn.setAttribute('aria-expanded', 'false');
    }
  }

  function setAboutExpanded(open: boolean) {
    if (!aboutGroup || !aboutBtn) return;
    aboutGroup.classList.toggle('is-about-open', open);
    aboutBtn.setAttribute('aria-expanded', String(open));
    if (open && servicesGroup && servicesBtn) {
      servicesGroup.classList.remove('is-services-open');
      servicesBtn.setAttribute('aria-expanded', 'false');
    }
  }

  function collapseSubmenusIfMobile() {
    if (!mq.matches) return;
    setServicesExpanded(false);
    setAboutExpanded(false);
  }

  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
      if (!open) {
        collapseSubmenusIfMobile();
      } else if (mq.matches) {
        if (servicesGroup?.dataset.servicesCurrent === 'true') {
          setServicesExpanded(true);
        }
        if (aboutGroup?.dataset.aboutCurrent === 'true') {
          setAboutExpanded(true);
        }
      }
    });
    links.forEach((l) =>
      l.addEventListener('click', () => {
        nav.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        collapseSubmenusIfMobile();
      })
    );
  }

  if (servicesGroup && servicesBtn) {
    servicesBtn.addEventListener('click', () => {
      if (!mq.matches) return;
      const next = !servicesGroup.classList.contains('is-services-open');
      setServicesExpanded(next);
    });
  }

  if (aboutGroup && aboutBtn) {
    aboutBtn.addEventListener('click', () => {
      if (!mq.matches) return;
      const next = !aboutGroup.classList.contains('is-about-open');
      setAboutExpanded(next);
    });
  }

  mq.addEventListener('change', (e) => {
    if (!e.matches) {
      setServicesExpanded(false);
      setAboutExpanded(false);
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Total chrome height incl. safe-area on narrow viewports (`global.css` tokens). */
    height: var(--header-h);
    padding-top: var(--header-safe-pad);
    display: flex;
    align-items: center;
    box-sizing: border-box;
    background: rgba(16, 33, 53, 0.78);
    backdrop-filter: var(--glass-blur-header);
    -webkit-backdrop-filter: var(--glass-blur-header);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  /*
    Sticky (not absolute) so nav stays pinned while scrolling; hero still uses `margin-top: -var(--header-h)`
    to paint the image under the chrome.
  */
  .site-header--transparent {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
    box-shadow: none;
    /* Let gradient “tail” paint past the header box (393-style handoff into the hero). */
    overflow: visible;
  }

  /* Keep chrome readable over the hero without a tinted “banner” bar */
  .site-header--transparent .site-header__logo,
  .site-header--transparent .site-header__logo--eagle .site-header__eagle-svg {
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.4));
  }

  .site-header--transparent .site-header__wordmark {
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.45);
  }

  .site-header--transparent .site-header__link {
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
  }

  .site-header--transparent .site-header__menu-btn {
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    width: 100%;
    /* Extra inset so logo + wordmark aren’t flush to the container edge */
    padding-inline: clamp(1.25rem, 4vw, 2.25rem);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-cream);
    margin-right: auto;
    transform: translateY(2px);
    opacity: 0.82;
    transition: opacity 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .site-header__brand:hover {
    color: #fff;
    opacity: 1;
  }

  .site-header__logo {
    width: clamp(44px, 5.5vw, 56px);
    height: auto;
  }

  .site-header__logo--eagle {
    display: block;
    flex-shrink: 0;
    color: #fff;
    line-height: 0;
  }

  .site-header__eagle-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-header__wordmark {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.2vw, 1.125rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .site-header__brand-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.05rem;
    line-height: 1;
  }

  .site-header__region {
    font-family: var(--font-ui);
    font-size: clamp(0.56rem, 1vw, 0.64rem);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(239, 236, 231, 0.66);
    line-height: 1.2;
  }

  .site-header__menu-btn {
    display: none;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-cream);
    background: transparent;
    border: 1px solid rgba(239, 236, 231, 0.25);
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .site-header__nav {
    display: flex;
    justify-content: flex-end;
    flex: 0 0 auto;
    margin-left: auto;
    transform: translateY(2px);
  }

  .site-header__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    justify-content: flex-end;
  }

  .site-header__link {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-cream-muted);
    white-space: nowrap;
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: #fff;
  }

  .site-header__group {
    position: relative;
  }

  /* Reset button chrome only — do not use `font: inherit` or it overrides .site-header__link sizing */
  .site-header__subtrigger {
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    border: none;
    background: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-ui);
    text-align: inherit;
    line-height: inherit;
  }

  .site-header__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 961px) {
    /* Floating submenu: no card, text only, drops in under Services */
    .site-header__sublist {
      position: absolute;
      top: calc(100% + 0.25rem);
      left: 0;
      transform: none;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
      padding: 0;
      margin: 0;
      min-width: max-content;
      background: none;
      border: none;
      border-radius: 0;
      box-shadow: none;
      visibility: hidden;
      pointer-events: none;
      /* Stay “visible” until row fades so exit motion can play (mirror of enter) */
      transition: visibility 0s linear 0.38s;
      z-index: 60;
    }

    /* Invisible hover bridge Services ↔ links */
    .site-header__sublist::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: -0.65rem;
      height: 0.65rem;
    }

    .site-header__group:hover .site-header__sublist,
    .site-header__group:focus-within .site-header__sublist {
      visibility: visible;
      pointer-events: auto;
      transition: visibility 0s;
    }

    .site-header__sublist > li {
      margin: 0;
      opacity: 0;
      transform: translateY(-0.45rem);
      transition:
        opacity 0.22s var(--ease-out),
        transform 0.26s var(--ease-out);
      transition-delay: 0s;
    }

    /* Enter: top → bottom */
    .site-header__group:hover .site-header__sublist > li,
    .site-header__group:focus-within .site-header__sublist > li {
      opacity: 1;
      transform: translateY(0);
    }

    .site-header__group:hover .site-header__sublist > li:nth-child(1),
    .site-header__group:focus-within .site-header__sublist > li:nth-child(1) {
      transition-delay: 0.04s;
    }

    .site-header__group:hover .site-header__sublist > li:nth-child(2),
    .site-header__group:focus-within .site-header__sublist > li:nth-child(2) {
      transition-delay: 0.1s;
    }

    .site-header__group:hover .site-header__sublist > li:nth-child(3),
    .site-header__group:focus-within .site-header__sublist > li:nth-child(3) {
      transition-delay: 0.16s;
    }

    /* Exit: bottom → top (reverse stagger) */
    .site-header__group:not(:hover):not(:focus-within) .site-header__sublist > li:nth-child(1) {
      transition-delay: 0.16s;
    }

    .site-header__group:not(:hover):not(:focus-within) .site-header__sublist > li:nth-child(2) {
      transition-delay: 0.08s;
    }

    .site-header__group:not(:hover):not(:focus-within) .site-header__sublist > li:nth-child(3) {
      transition-delay: 0s;
    }

    .site-header__sublist .site-header__sublink {
      display: block;
      padding: 0.15rem 0;
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      line-height: 1.25;
      white-space: nowrap;
      text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
    }

    .site-header--transparent .site-header__sublist .site-header__sublink {
      text-shadow: 0 1px 12px rgba(0, 0, 0, 0.5);
    }
  }

  @media (min-width: 961px) and (prefers-reduced-motion: reduce) {
    .site-header__sublist {
      transition: none;
    }

    .site-header__sublist > li {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .site-header__group:not(:hover):not(:focus-within) .site-header__sublist > li {
      transition-delay: 0s;
    }
  }

  @media (max-width: 960px) {
    /*
      Feathered top band (structure like 393westend.com, inverted for dark UI):
      paint a soft gradient *on the header layer* instead of relying on transparency to reveal the
      hero scrim through WebKit’s sticky compositor (which often reads as a flat navy/black slab).
    */
    .site-header--transparent::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      /* Softer cap than 0.52 — reads flatter on iOS P3 + sticky compositing. */
      transform: translateZ(0);
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.34) 0%,
        rgba(0, 0, 0, 0.18) 38%,
        rgba(0, 0, 0, 0.06) 72%,
        rgba(0, 0, 0, 0) 100%
      );
    }

    /* Short tail below the chrome so the handoff into the photo is gradual, not a hard seam. */
    .site-header--transparent::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      height: clamp(64px, 22vw, 140px);
      z-index: 0;
      pointer-events: none;
      transform: translateZ(0);
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.14) 0%,
        rgba(0, 0, 0, 0.04) 52%,
        rgba(0, 0, 0, 0) 100%
      );
    }

    .site-header--transparent .site-header__inner {
      position: relative;
      z-index: 1;
    }

    .site-header--transparent .site-header__logo,
    .site-header--transparent .site-header__logo--eagle .site-header__eagle-svg {
      filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.28));
    }

    .site-header--transparent .site-header__wordmark {
      text-shadow: 0 1px 8px rgba(0, 0, 0, 0.32);
    }

    .site-header--transparent .site-header__menu-btn {
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
    }

    /*
      Tuck chrome under Dynamic Island: base nudge + extra lift scaled to `safe-area-inset-top`
      (capped) so large-island phones move ~25–30px without changing `--header-h` / hero math.
    */
    .site-header__inner {
      transform: translateY(
        calc(-0.22rem - min(30px, max(10px, calc(env(safe-area-inset-top, 0px) * 0.45))))
      );
    }

    .site-header__brand {
      transform: none;
    }

    .site-header__menu-btn {
      display: block;
    }

    /* Text-only control over the gradient — no filled chip that reads as a second bar. */
    .site-header--transparent .site-header__menu-btn {
      border-color: rgba(255, 255, 255, 0.22);
      background: transparent;
      box-shadow: none;
    }

    .site-header__nav {
      position: fixed;
      inset: var(--header-h) 0 0;
      z-index: 70;
      background: rgba(16, 33, 53, 0.98);
      padding: var(--space-lg);
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.3s var(--ease-out), opacity 0.3s var(--ease-out);
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      overflow-y: auto;
      margin-left: 0;
      flex: none;
    }

    .site-header__nav.is-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .site-header__list {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: var(--space-md);
    }

    .site-header__group {
      width: 100%;
    }

    .site-header__sublist {
      display: none;
      margin-top: 0.5rem;
      padding-left: 0;
      border: none;
      width: 100%;
      box-sizing: border-box;
    }

    .site-header__group.is-services-open .site-header__sublist,
    .site-header__group.is-about-open .site-header__sublist {
      display: block;
    }

    .site-header__sublist .site-header__sublink {
      display: block;
      padding: 0.35rem 0;
      font-size: 1rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      line-height: 1.25;
    }

    .site-header__link {
      font-size: 1rem;
    }

  }
</style>
