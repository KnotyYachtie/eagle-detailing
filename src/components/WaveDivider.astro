---
/* Infinite wave layers (jh3yy / CodePen style): wide div + SVG background + translate(-50%) loop */
---

<div class="waves-wrap" aria-hidden="true">
  <div class="wave wave--1"></div>
  <div class="wave wave--2"></div>
  <div class="wave wave--3"></div>
</div>

<style>
  .waves-wrap {
    position: relative;
    width: 100%;
    line-height: 0;
    margin-bottom: -1px;
    overflow: hidden;
    height: clamp(12.5rem, 21vw, 17rem);
    min-height: 9rem;
    max-height: 18rem;
  }

  .wave {
    position: absolute;
    left: 0;
    bottom: -14%;
    height: calc(var(--height, 18) * 1vh);
    width: calc(var(--width, 200) * 1%);
    background-image: url('/wave-infinite.svg');
    background-repeat: repeat-x;
    background-position: 0 0;
    background-size: 50% 100%;
    opacity: var(--opacity, 0.16);
    animation: wave-roll calc(var(--speed, 22) * 1s) linear infinite;
    backface-visibility: hidden;
    /* Slight soften so stacked dark layers read as haze, not hard ribbons */
    filter: blur(0.45px);
  }

  .wave--1 {
    z-index: 1;
    --speed: 22;
    --opacity: 0.12;
    --height: 26;
    --width: 240;
  }

  .wave--2 {
    z-index: 2;
    --speed: 32;
    --opacity: 0.16;
    --height: 28;
    --width: 280;
  }

  .wave--3 {
    z-index: 3;
    --speed: 10;
    --opacity: 0.14;
    --height: 22;
    --width: 220;
  }

  @keyframes wave-roll {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(-50%, 0);
    }
  }

  @media (max-width: 480px) {
    .waves-wrap {
      height: clamp(10.5rem, 26vw, 14rem);
    }

    .wave {
      height: calc(var(--height, 18) * 0.82vh);
      filter: blur(0.35px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave {
      animation: none;
      filter: none;
    }
  }
</style>
