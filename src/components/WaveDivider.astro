---
/* Inspired by Goodkatz "Simple CSS Waves" — colors match Eagle navy palette */
---

<div class="waves-wrap" aria-hidden="true">
  <svg
    class="waves"
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    viewBox="0 24 150 28"
    preserveAspectRatio="none"
  >
    <defs>
      <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"></path>
    </defs>
    <g class="parallax">
      <use xlink:href="#gentle-wave" x="48" y="0" fill="rgba(7, 43, 83, 0.35)"></use>
      <use xlink:href="#gentle-wave" x="48" y="3" fill="rgba(16, 33, 53, 0.55)"></use>
      <use xlink:href="#gentle-wave" x="48" y="5" fill="rgba(10, 22, 40, 0.75)"></use>
      <use xlink:href="#gentle-wave" x="48" y="7" fill="#0a1628"></use>
    </g>
  </svg>
</div>

<style>
  .waves-wrap {
    width: 100%;
    line-height: 0;
    margin-bottom: -1px;
  }

  .waves {
    position: relative;
    width: 100%;
    height: 4.5rem;
    min-height: 3rem;
    max-height: 5.5rem;
  }

  .parallax > use {
    animation: wave-shift 22s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
  }

  .parallax > use:nth-child(1) {
    animation-delay: -2s;
    animation-duration: 9s;
  }

  .parallax > use:nth-child(2) {
    animation-delay: -3s;
    animation-duration: 12s;
  }

  .parallax > use:nth-child(3) {
    animation-delay: -4s;
    animation-duration: 15s;
  }

  .parallax > use:nth-child(4) {
    animation-delay: -5s;
    animation-duration: 20s;
  }

  @keyframes wave-shift {
    0% {
      transform: translate3d(-88px, 0, 0);
    }
    100% {
      transform: translate3d(82px, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .parallax > use {
      animation: none;
    }
  }
</style>
