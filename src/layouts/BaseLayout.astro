---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  transparentHeader?: boolean;
}

const {
  title,
  description = SITE.description,
  transparentHeader = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const pageTitle = title === SITE.shortName ? title : `${title} · ${SITE.shortName}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE.name,
  image: `${SITE.url}/logo-blue-on-white.png`,
  '@id': SITE.url,
  url: SITE.url,
  telephone: SITE.phoneTel,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.locality,
    addressRegion: SITE.region,
    addressCountry: SITE.country,
  },
  areaServed: 'South Florida',
  description: SITE.description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.shortName} />
    <meta property="og:image" content={`${SITE.url}/jet-2.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="page">
      <Header currentPath={Astro.url.pathname} transparent={transparentHeader} />
      <main class="page__main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .page__main {
    flex: 1;
  }
</style>
