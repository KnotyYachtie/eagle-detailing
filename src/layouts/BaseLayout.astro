---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  transparentHeader?: boolean;
  /** When set, `<html>` gets `data-home-load-intro` for homepage-only load choreography (no FOUC). */
  dataHomeLoadIntro?: boolean;
}

const {
  title,
  description = SITE.description,
  transparentHeader = false,
  dataHomeLoadIntro = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const pageTitle = title === SITE.shortName ? title : `${title} · ${SITE.shortName}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE.name,
  image: `${SITE.url}/logo-blue-on-white.png`,
  '@id': SITE.url,
  url: SITE.url,
  telephone: SITE.phoneTel,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.locality,
    addressRegion: SITE.region,
    addressCountry: SITE.country,
  },
  areaServed: 'South Florida',
  description: SITE.description,
};
---

<!doctype html>
<html lang="en" data-home-load-intro={dataHomeLoadIntro ? true : undefined}>
  <head>
    <meta charset="UTF-8" />
    <!--
      First-paint scroll + chrome: must match `global.css` so external CSS does not re-resolve overflow
      (avoids a one-frame “stutter”). `overflow-y: scroll` keeps a stable vertical scrollbox while the
      scrollbar is hidden; avoid `overflow-x` on `body` — it can pair with `overflow-y` and fight `html`.
    -->
    <style is:inline>
      html {
        overflow-y: scroll;
        overflow-x: hidden;
        scrollbar-width: none;
        background: #102135;
      }
      html::-webkit-scrollbar {
        display: none;
        width: 0;
        height: 0;
        background: transparent;
      }
      body {
        margin: 0;
        min-height: 100vh;
        background: #102135;
        scrollbar-width: none;
      }
      body::-webkit-scrollbar {
        display: none;
        width: 0;
        height: 0;
        background: transparent;
      }
      .page {
        overflow-x: hidden;
      }
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.shortName} />
    <meta property="og:image" content={`${SITE.url}/jet-2.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="page">
      <Header currentPath={Astro.url.pathname} transparent={transparentHeader} />
      <main class="page__main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  .page__main {
    flex: 1;
  }
</style>
