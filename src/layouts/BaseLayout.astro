---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  transparentHeader?: boolean;
  /** When set, `<html>` gets `data-home-load-intro` for homepage-only load choreography (no FOUC). */
  dataHomeLoadIntro?: boolean;
  /** Browser chrome color on mobile (Safari/Chrome UI bars). */
  themeColor?: string;
  /**
   * Optional neutral canvas behind the document (html/body + first-paint inline CSS).
   * Use on the home hero so `#102135` brand navy does not tint Safari’s top chrome.
   */
  canvasColor?: string;
}

const {
  title,
  description = SITE.description,
  transparentHeader = false,
  dataHomeLoadIntro = false,
  themeColor = '#102135',
  canvasColor,
} = Astro.props;

const criticalCanvas = canvasColor ?? '#102135';

/**
 * Homepage: first paint sets `--hero-inner-vh`; mobile-only `--home-prescroll-y` + scroll (desktop stays 0).
 */
const homeHeroViewportHeadScript = dataHomeLoadIntro
  ? `(function(){try{var d=document.documentElement;if(!d.hasAttribute('data-home-load-intro'))return;var vv=window.visualViewport;var ih=Math.round((vv&&vv.height)||window.innerHeight||0);if(ih)d.style.setProperty('--hero-inner-vh',ih+'px');if(window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;if(!window.matchMedia('(max-width:960px)').matches){d.style.setProperty('--home-prescroll-y','0px');return;}var y=Math.round(Math.min(132,Math.max(52,ih*0.092)));d.style.setProperty('--home-prescroll-y',y+'px');try{if('scrollRestoration'in history)history.scrollRestoration='manual';}catch(e){}window.scrollTo(0,y);}catch(e){}})();`
  : '';

/** First-paint scroll + canvas; values injected so `canvasColor` affects Safari before `global.css`. */
const criticalInlineCss = `
      html {
        overflow-y: scroll;
        overflow-x: hidden;
        scrollbar-width: none;
        background: ${criticalCanvas};
      }
      html::-webkit-scrollbar {
        display: none;
        width: 0;
        height: 0;
        background: transparent;
      }
      body {
        margin: 0;
        min-height: 100vh;
        background: ${criticalCanvas};
        scrollbar-width: none;
      }
      body::-webkit-scrollbar {
        display: none;
        width: 0;
        height: 0;
        background: transparent;
      }
`;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const pageTitle = title === SITE.shortName ? title : `${title} · ${SITE.shortName}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE.name,
  image: `${SITE.url}/logo-blue-on-white.png`,
  '@id': SITE.url,
  url: SITE.url,
  telephone: SITE.phoneTel,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.locality,
    addressRegion: SITE.region,
    addressCountry: SITE.country,
  },
  areaServed: 'South Florida',
  description: SITE.description,
};
---

<!doctype html>
<html
  lang="en"
  data-home-load-intro={dataHomeLoadIntro ? true : undefined}
  style={canvasColor ? `--page-canvas: ${canvasColor}` : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <!-- `viewport-fit=cover` must precede any CSS that uses `env(safe-area-inset-*)` (header inset). -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!--
      First-paint scroll + chrome: must match `global.css` so external CSS does not re-resolve overflow
      (avoids a one-frame “stutter”). `overflow-y: scroll` keeps a stable vertical scrollbox while the
      scrollbar is hidden; avoid `overflow-x` on `body` — it can pair with `overflow-y` and fight `html`.
    -->
    <style is:inline set:html={criticalInlineCss} />
    {homeHeroViewportHeadScript && <script is:inline set:html={homeHeroViewportHeadScript} />}
    <meta name="theme-color" content={themeColor} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.shortName} />
    <meta property="og:image" content={`${SITE.url}/jet-2.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="page">
      <Header currentPath={Astro.url.pathname} transparent={transparentHeader} />
      <main class="page__main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

