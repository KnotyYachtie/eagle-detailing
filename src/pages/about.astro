---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';
import yacht3 from '../../assets/yacht3.png';
---

<BaseLayout
  title="About"
  description={`${SITE.name} — yacht and aircraft care plus luxury mobile detailing across South Florida.`}
  ogImage={yacht3}
>
  <section class="page-hero u-container">
    <p class="u-eyebrow">Craft</p>
    <h1>About {SITE.shortName}</h1>
    <p class="u-muted page-hero__lede">
      We are built for owners and operators who notice the small things — where finish quality signals care,
      discipline, and respect for the asset.
    </p>
  </section>
  <section class="u-section page-body">
    <div class="u-container prose">
      <p>
        {SITE.name} is led by <strong style="color: var(--color-cream)">{SITE.owner}</strong>. We are not a
        volume shop aesthetic: we carry a single standard across <strong style="color: var(--color-cream)"
          >marine</strong
        >,
        <strong style="color: var(--color-cream)">aviation</strong>, and
        <strong style="color: var(--color-cream)">high-end automotive</strong> — correction, protection, and
        maintenance programs you can schedule with confidence.
      </p>
      <p class="u-muted">
        Based in {SITE.locality}, we operate mobile throughout South Florida — licensed & insured, focused on
        private clients who expect prompt communication and uncompromising execution.
      </p>
      <p><a class="u-btn" href="/contact">Contact</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-xl) var(--space-md);
  }

  .page-hero__lede {
    max-width: 40rem;
    font-size: 1.0625rem;
  }

  .page-body {
    background: #0a1628;
  }

  .prose p {
    max-width: 40rem;
  }
</style>
