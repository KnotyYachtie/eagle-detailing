---
import ServiceEditorialPage from '../components/ServiceEditorialPage.astro';
import { SERVICE_EDITORIAL_SHELL_COLORS } from '../site';
import car5 from '../../assets/automotive/car5.png';
import car3 from '../../assets/automotive/car3.png';
import c2 from '../../assets/automotive/c2.png';
import c1 from '../../assets/automotive/carousel/c1.png';
import carousel2 from '../../assets/automotive/carousel/c2.png';
import carousel4 from '../../assets/automotive/carousel/c4.png';
import carousel5 from '../../assets/automotive/carousel/c5.png';
import carousel6 from '../../assets/automotive/carousel/c6.png';
import eagleSvgRaw from '../../assets/eagle.svg?raw';

const eagleAutomotiveServicesVisual = eagleSvgRaw.replace(
  /<svg[\s\S]*?>/,
  '<svg class="marine-services__eagle-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 503 408" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true">'
);
---

<ServiceEditorialPage
  title="Automotive"
  description="Automotive detailing in South Florida — restoration, refinement, and protection for every vehicle with a measured focus on clarity, depth, and longevity."
  themeColor={SERVICE_EDITORIAL_SHELL_COLORS.themeColor}
  canvasColor={SERVICE_EDITORIAL_SHELL_COLORS.canvasColor}
  editorialVertical="automotive"
  heroEyebrow="Automotive"
  heroTitle="Refined finishes. Preserved."
  heroLede="From modern masterpieces to antique icons, we restore, refine, and protect every vehicle with a measured approach focused on clarity, depth, and longevity."
  heroParallax={car5}
  chapterLeftLabelId="automotive-ch-1"
  chapterLeftLabel="From inspection to protection"
  chapterLeftParagraphs={[
    'Automotive finishes vary widely in hardness, thickness, and how they respond to correction. Each vehicle is thoroughly evaluated before work begins, with processes tailored to deliver consistent, showroom-level results every time.',
    'Whether interior surface or exterior finish, every section is approached with the same level of care and attention, ensuring consistent results.',
  ]}
  chapterLeftImage={car3}
  chapterRightLabelId="automotive-ch-2"
  chapterRightLabel="Driven to deliver"
  chapterRightParagraphs={[
    'On your schedule. At your location. Coordinated in advance so nothing is left to chance.',
    "The standard doesn't change. Neither do the results.",
  ]}
  chapterRightImage={c2}
  quoteText="Placeholder client quote — replace when testimonials are approved."
  servicesEyebrowId="automotive-services-label"
  servicesHeadlineId="automotive-services-headline"
  servicesEyebrow="Services we offer"
  servicesHeadline="Curated care for exceptional automobiles"
  servicesLede="Please contact us via the form below to discuss your specific project. We're here to create a solution tailored for you."
  servicesCtaTitle="Emergency detail or prompt service?"
  servicesCtaSub="We're here to help!"
  reachHeadingId="automotive-reach-h"
  reachSubjectPrefix="Automotive"
  reachTitle="Get in touch"
  reachLede="Placeholder — invite new clients to use the form; we'll respond when copy is final."
  reachMessageLabel="Tell us about your vehicle"
  reachMessageHint="e.g. year, make, model, location, service needed, preferred timing"
  formFieldPrefix="automotive"
  carouselId="automotive-featured-carousel"
  carouselAriaLabel="Featured work — placeholder"
  carouselSlideAlt="Featured work — placeholder"
  carouselImages={[c1, carousel2, carousel4, carousel5, carousel6]}
  eagleSvgHtml={eagleAutomotiveServicesVisual}
>
  <ul slot="services-rows" class="marine-services__rows" role="list">
    <li class="marine-services__row">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
        </svg>
      </span>
      <span class="marine-services__row-text">Maintenance washes &amp; ongoing care programs</span>
    </li>
    <li class="marine-services__row">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
        </svg>
      </span>
      <span class="marine-services__row-text">Paint correction &amp; surface restoration</span>
    </li>
    <li class="marine-services__row">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 22s8-4.5 8-11V5l-8-3-8 3v6c0 6.5 8 11 8 11z"></path>
        </svg>
      </span>
      <span class="marine-services__row-text">Ceramic coatings offering long-term protection</span>
    </li>
    <li class="marine-services__row">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 14c1.5 0 2-2 3.5-2s2 2 3.5 2 2-2 3.5-2 2 2 3.5 2"></path>
          <path d="M4 10c1.5 0 2-2 3.5-2s2 2 3.5 2 2-2 3.5-2 2 2 3.5 2"></path>
          <path d="M4 18c1.5 0 2-2 3.5-2s2 2 3.5 2 2-2 3.5-2 2 2 3.5 2"></path>
        </svg>
      </span>
      <span class="marine-services__row-text">Wheels, glass &amp; trim restoration</span>
    </li>
    <li class="marine-services__row">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 11V9a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v2"></path>
          <path d="M5 11h14v8a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-8zM9 15h6"></path>
        </svg>
      </span>
      <span class="marine-services__row-text">Interior detailing, deep cleaning &amp; conditioning</span>
    </li>
    <li class="marine-services__row">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 3v2M12 19v2M5 12h2M17 12h2M6.3 6.3l1.4 1.4M16.3 16.3l1.4 1.4M17.7 6.3l-1.4 1.4M7.7 16.3l-1.4 1.4"></path>
          <circle cx="12" cy="12" r="2"></circle>
        </svg>
      </span>
      <span class="marine-services__row-text">Interior sanitization and deodorizing</span>
    </li>
    <li class="marine-services__row marine-services__row--last">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 22s8-4.5 8-11V5l-8-3-8 3v6c0 6.5 8 11 8 11z"></path>
        </svg>
      </span>
      <span class="marine-services__row-text">Interior surface ceramic coatings and preservation</span>
    </li>
  </ul>
</ServiceEditorialPage>
