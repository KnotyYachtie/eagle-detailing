---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Aviation"
  description="Private aircraft detailing in South Florida — exterior gloss, brightwork, cabin care, and protection with discretion and scheduling rigor."
>
  <section class="page-hero u-container">
    <p class="u-eyebrow">Aviation</p>
    <h1>Private aircraft detailing</h1>
    <p class="u-muted page-hero__lede">
      We treat airframe finishes and cabins with the same precision mindset as our marine work — coordinated
      around your operations, hangar access, and downtime windows.
    </p>
  </section>
  <section class="u-section page-body">
    <div class="u-container prose">
      <h2>Services</h2>
      <ul>
        <li>Exterior wash, decontamination, and gloss restoration</li>
        <li>Paint correction and refinement (scope per substrate and ops)</li>
        <li>Protective coatings where appropriate and approved for your program</li>
        <li>Brightwork and accent metal care</li>
        <li>Cabin leather, surfaces, and details</li>
      </ul>
      <p class="u-muted">
        Product and process choices should always align with your maintenance manual and operator policies —
        we scope conservatively and communicate clearly.
      </p>
      <p><a class="u-btn" href="/contact">Contact</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-xl) var(--space-md);
  }

  .page-hero__lede {
    max-width: 40rem;
    font-size: 1.0625rem;
  }

  .page-body {
    background: #0a1628;
  }

  .prose h2 {
    margin-top: 0;
  }

  .prose ul {
    margin: 0 0 var(--space-md);
    padding-left: 1.25rem;
    color: var(--color-cream-muted);
  }

  .prose li {
    margin-bottom: 0.35rem;
  }
</style>
