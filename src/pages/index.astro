  }

  @media (min-width: 640px) {
    .domains__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /*
    Camden-style domain cards (inspo HTML/CSS): radial shell, stacked inset shadows, clip-path frame,
    3D slit + lumen + darken. Same shell color as inspo snippet on all variants. Lumen on when section is lit or card hover/focus.
  */
  .card-domain {
    --camden-offset: 0.65rem;
    --camden-ax: min(3.25rem, 9vw);
    display: flex;
    flex-direction: column;
    position: relative;
    isolation: isolate;
    overflow: visible;
    padding: clamp(1.15rem, 2.6vw, 1.65rem);
    text-decoration: none;
    color: inherit;
    border: none;
    border-radius: 1.75rem;
    font-size: clamp(9px, min(1.05vw, 1.35vh), 12px);
    box-shadow:
      inset 0 1rem 0.2rem -1rem rgba(255, 255, 255, 0),
      inset 0 -1rem 0.2rem -1rem rgba(0, 0, 0, 0),
      0 -1rem 0.2rem -1rem rgba(255, 255, 255, 0),
      0 1rem 0.2rem -1rem rgba(0, 0, 0, 0),
      0 0 0 1px rgba(255, 255, 255, 0.18),
      0 4px 4px 0 rgba(0, 0, 0, 0.22),
      0 0 0 1px rgba(40, 48, 58, 0.85);
    background: radial-gradient(circle at 50% 0%, #3a3a3a 0%, #1a1a1a 64%);
    backdrop-filter: blur(14px) saturate(1.05);
    -webkit-backdrop-filter: blur(14px) saturate(1.05);
    aspect-ratio: 3 / 4;
    max-height: min(34rem, 74vh);
    min-height: 18rem;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.35s ease;
  }

  .card-domain::before {
    content: '';
    display: block;
    width: calc(100% + 2 * var(--camden-offset));
    height: calc(100% + 2 * var(--camden-offset));
    position: absolute;
    left: calc(-1 * var(--camden-offset));
    top: calc(-1 * var(--camden-offset));
    margin: auto;
    z-index: 1;
    pointer-events: none;
    box-shadow: inset 0 0 0 0.06rem rgba(255, 255, 255, 0.12);
    border-radius: 2.35rem;
    clip-path: polygon(
      var(--camden-ax) 0,
      0 0,
      0 var(--camden-ax),
      var(--camden-ax) var(--camden-ax),
      var(--camden-ax) calc(100% - var(--camden-ax)),
      0 calc(100% - var(--camden-ax)),
      0 100%,
      var(--camden-ax) 100%,
      var(--camden-ax) calc(100% - var(--camden-ax)),
      calc(100% - var(--camden-ax)) calc(100% - var(--camden-ax)),
      calc(100% - var(--camden-ax)) 100%,
      100% 100%,
      100% calc(100% - var(--camden-ax)),
      calc(100% - var(--camden-ax)) calc(100% - var(--camden-ax)),
      calc(100% - var(--camden-ax)) var(--camden-ax),
      100% var(--camden-ax),
      100% 0,
      calc(100% - var(--camden-ax)) 0,
      calc(100% - var(--camden-ax)) var(--camden-ax),
      var(--camden-ax) var(--camden-ax)
    );
    transition:
      width 0.4s ease-in-out,
      height 0.4s ease-in-out,
      left 0.4s ease-in-out,
      top 0.4s ease-in-out,
      border-radius 0.4s ease-in-out,
      box-shadow 0.4s ease-in-out,
      clip-path 0.4s ease-in-out;
  }

  .card-domain:hover::before {
    --camden-offset: 0.4rem;
    --camden-ax: min(4.5rem, 14vw);
    border-radius: 2rem;
    box-shadow: inset 0 0 0 0.08rem rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 639px) {
    .card-domain {
      aspect-ratio: 4 / 3;
      max-height: none;
      min-height: 15rem;
    }
  }

  .card-domain__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .card-domain__light {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    transform-style: preserve-3d;
    perspective: 400px;
  }

  .card-domain__slit {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: auto;
    width: 64%;
    height: 1.2rem;
    transform: rotateX(-76deg);
    background: #121212;
    box-shadow: 0 0 4px 0 rgba(255, 255, 255, 0);
    transition: background 0.4s ease-in-out, box-shadow 0.4s ease-in-out;
  }

  .card-domain__lumen {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 100%;
    height: 100%;
    perspective: 400px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s ease-in-out;
  }

  .card-domain__lumen-min {
    width: 70%;
    height: 3rem;
    background: linear-gradient(rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.67));
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 2.5rem;
    margin: auto;
    transform: rotateX(-42deg);
    opacity: 0.4;
  }

  .card-domain__lumen-mid {
    width: 74%;
    height: 13rem;
    background: linear-gradient(rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.67));
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 10em;
    margin: auto;
    transform: rotateX(-42deg);
    filter: blur(1rem);
    opacity: 0.8;
    border-radius: 100% 100% 0 0;
  }

  .card-domain__lumen-hi {
    width: 50%;
    height: 13rem;
    background: linear-gradient(rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.67));
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 12em;
    margin: auto;
    transform: rotateX(22deg);
    filter: blur(1rem);
    opacity: 0.6;
    border-radius: 100% 100% 0 0;
  }

  .card-domain__darken {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 100%;
    height: 100%;
    perspective: 400px;
    pointer-events: none;
    opacity: 0.5;
    transition: opacity 0.45s ease-in-out;
  }

  .card-domain__darken-sl,
  .card-domain__darken-ll,
  .card-domain__darken-slt,
  .card-domain__darken-srt {
    transition: opacity 0.45s ease-in-out;
  }

  .card-domain__darken-sl {
    width: 64%;
    height: 10rem;
    background: linear-gradient(#000, transparent);
    position: absolute;
    left: 0;
    right: 0;
    top: 9.6em;
    bottom: 0;
    margin: auto;
    filter: blur(0.2rem);
    opacity: 0.1;
    border-radius: 0 0 100% 100%;
    transform: rotateX(-22deg);
  }

  .card-domain__darken-ll {
    width: 62%;
    height: 10rem;
    background: linear-gradient(rgba(0, 0, 0, 0.67), transparent);
    position: absolute;
    left: 0;
    right: 0;
    top: 11em;
    bottom: 0;
    margin: auto;
    filter: blur(0.8rem);
    opacity: 0.4;
    border-radius: 0 0 100% 100%;
    transform: rotateX(22deg);
  }

  .card-domain__darken-slt {
    width: 0.5rem;
    height: 4rem;
    background: linear-gradient(rgba(0, 0, 0, 0.33), transparent);
    position: absolute;
    left: min(8%, 2.5rem);
    right: auto;
    top: 3.9em;
    bottom: 0;
    margin: auto;
    opacity: 0.6;
    border-radius: 0 0 100% 100%;
    transform: skewY(42deg);
  }

  .card-domain__darken-srt {
    width: 0.5rem;
    height: 4rem;
    background: linear-gradient(rgba(0, 0, 0, 0.33), transparent);
    position: absolute;
    right: min(8%, 2.5rem);
    left: auto;
    top: 3.9em;
    bottom: 0;
    margin: auto;
    opacity: 0.6;
    border-radius: 0 0 100% 100%;
    transform: skewY(-42deg);
  }

  .card-domain:hover .card-domain__slit,
  .card-domain:focus-visible .card-domain__slit {
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 0 5px 0 rgba(255, 255, 255, 0.45);
  }

  .card-domain:hover .card-domain__lumen,
  .card-domain:focus-visible .card-domain__lumen {
    opacity: 0.48;
  }

  .card-domain:hover .card-domain__darken,
  .card-domain:focus-visible .card-domain__darken {
    opacity: 0.8;
  }

  .card-domain:hover .card-domain__darken-sl,
  .card-domain:focus-visible .card-domain__darken-sl {
    opacity: 0.2;
  }

  .card-domain:hover .card-domain__darken-ll,
  .card-domain:hover .card-domain__darken-slt,
  .card-domain:hover .card-domain__darken-srt,
  .card-domain:focus-visible .card-domain__darken-ll,
  .card-domain:focus-visible .card-domain__darken-slt,
  .card-domain:focus-visible .card-domain__darken-srt {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-domain::before,
    .card-domain__slit,
    .card-domain__lumen,
    .card-domain__darken,
    .card-domain__darken-sl,
    .card-domain__darken-ll,
    .card-domain__darken-slt,
    .card-domain__darken-srt {
      transition: none;
    }
  }

  /* Scroll-into-view reveal (IntersectionObserver adds `.active`) */
  .card-domain[data-domain-reveal] {
    opacity: 0;
    transform: scale(0.97) translate3d(0, 3.25rem, 0);
    filter: brightness(0.55);
    pointer-events: none;
    transition:
      opacity 1.48s cubic-bezier(0.18, 1, 0.26, 1),
      transform 1.48s cubic-bezier(0.18, 1, 0.26, 1),
      filter 1.48s cubic-bezier(0.18, 1, 0.26, 1),
      box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.35s ease;
  }

  .card-domain[data-domain-reveal].active {
    opacity: 1;
    transform: scale(1) translate3d(0, 0, 0);
    filter: brightness(1);
    pointer-events: auto;
  }

  .card-domain[data-domain-reveal]:not(.active):hover {
    transform: scale(0.97) translate3d(0, 3.25rem, 0);
  }

  .card-domain[data-domain-reveal].active:hover {
    transform: translateY(-0.35rem);
    box-shadow:
      inset 0 1rem 0.12rem -1rem rgba(255, 255, 255, 0.35),
      inset 0 -3.5rem 2.5rem -2.5rem rgba(0, 0, 0, 0.35),
      0 -1rem 0.2rem -1rem rgba(255, 255, 255, 0.2),
      0 1rem 0.2rem -1rem rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(255, 255, 255, 0.22),
      0 12px 28px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(32, 40, 52, 0.9);
  }

  .card-domain[data-domain-reveal].active:active {
    transform: translateY(-0.12rem);
  }

  .card-domain:hover {
    transform: translateY(-0.35rem);
    box-shadow:
      inset 0 1rem 0.12rem -1rem rgba(255, 255, 255, 0.28),
      inset 0 -3.5rem 2.5rem -2.5rem rgba(0, 0, 0, 0.32),
      0 -1rem 0.2rem -1rem rgba(255, 255, 255, 0.18),
      0 1rem 0.2rem -1rem rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.2),
      0 12px 28px rgba(0, 0, 0, 0.38),
      0 0 0 1px rgba(32, 40, 52, 0.88);
  }

  .card-domain:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .card-domain:active {
    transform: translateY(-0.12rem);
  }

  .card-domain__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 1.85rem);
