---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { SITE } from '../site';
import aviationTn from '../../assets/aviation-tn.jpg';
---

<BaseLayout title={SITE.shortName} transparentHeader={true}>
  <section class="hero">
    <div class="hero__media">
      <img
        src="/jet-2.png"
        alt="Private aircraft exterior — precision detailing and protection"
        width="2400"
        height="1600"
        fetchpriority="high"
        decoding="async"
        class="hero__img"
      />
      <div class="hero__scrim" aria-hidden="true"></div>
    </div>
    <div class="hero__waves">
      <WaveDivider />
    </div>
    <div class="hero__blue-veil" aria-hidden="true"></div>
    <div class="hero__metrics" aria-label="Company highlights" role="region">
      <div class="hero__metrics-inner u-container">
        <div class="hero__metric" data-count-row>
          <p class="hero__metric-value">
            <span class="hero__metric-num" data-count-to="5">0</span><span class="hero__metric-suffix">+</span>
          </p>
          <p class="hero__metric-label">Years of excellence</p>
        </div>
        <div class="hero__metric hero__metric--text">
          <p class="hero__metric-value hero__metric-value--text">Fully insured</p>
          <p class="hero__metric-label" aria-hidden="true">&nbsp;</p>
        </div>
        <div class="hero__metric" data-count-row>
          <p class="hero__metric-value">
            <span class="hero__metric-num" data-count-to="100">0</span><span class="hero__metric-suffix">+</span>
          </p>
          <p class="hero__metric-label">Projects completed</p>
        </div>
      </div>
    </div>
    <div class="hero__content u-container">
      <p class="u-eyebrow">Fort Lauderdale · South Florida</p>
      <h1 class="hero__title">
        <span class="hero__title-lead">Expert care for</span>
        <span class="hero__title-rest">private vessels, aircraft and collector automobiles.</span>
      </h1>
      <p class="hero__lede">
        Paint Correction, ceramic protection, and disciplined maintenance — delivered mobile to marinas, FBOs, and
        private collections.
      </p>
      <div class="hero__actions">
        <a class="u-btn hero__cta" href="/contact">Request a quote</a>
      </div>
    </div>
  </section>
  <section class="u-section domains">
    <div class="u-container">
      <p class="u-eyebrow">Domains</p>
      <h2>One standard across three worlds</h2>
      <p class="u-muted domains__intro">
        The same inspection-driven process — scaled to gelcoat, airframe finishes, and high-end automotive
        paint systems.
      </p>
      <div class="domains__grid">
        <a
          class="card-domain card-domain--marine"
          href="/marine"
          data-domain-card
          data-domain-reveal
        >
          <h3 class="card-domain__title">Marine</h3>
          <div class="card-domain__visual card-domain__visual--marine" aria-hidden="true"></div>
          <div class="card-domain__body">
            <p>
              Luxury center consoles to superyachts — gelcoat, brightwork, interiors, and show-ready prep.
            </p>
          </div>
          <span class="card-domain__cta">Explore</span>
        </a>
        <a
          class="card-domain card-domain--aviation"
          href="/aviation"
          data-domain-card
          data-domain-reveal
        >
          <h3 class="card-domain__title">Aviation</h3>
          <div class="card-domain__visual card-domain__visual--aviation" aria-hidden="true">
            <img
              class="card-domain__img"
              src={aviationTn.src}
              alt=""
              width={aviationTn.width}
              height={aviationTn.height}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="card-domain__body">
            <p>Private aircraft exteriors and cabins — discretion, scheduling, and finish integrity first.</p>
          </div>
          <span class="card-domain__cta">Explore</span>
        </a>
        <a
          class="card-domain card-domain--automotive"
          href="/automotive"
          data-domain-card
          data-domain-reveal
        >
          <h3 class="card-domain__title">Automotive</h3>
          <div class="card-domain__visual card-domain__visual--automotive" aria-hidden="true"></div>
          <div class="card-domain__body">
            <p>High-end paint correction, ceramic coating, and maintenance for exceptional road cars.</p>
          </div>
          <span class="card-domain__cta">Explore</span>
        </a>
      </div>
    </div>
  </section>
  <section class="u-section u-section--tight trust">
    <div class="u-container trust__inner">
      <p>Serving South Florida</p>
      <p>Private clients</p>
      <p>Fully insured</p>
    </div>
  </section>
  <section class="u-section process-preview">
    <div class="u-container process-preview__grid">
      <div>
        <p class="u-eyebrow">Process</p>
        <h2>Inspection to longevity</h2>
        <p class="u-muted">
          Every engagement begins with surfaces, environment, and how you use the asset — then we build a
          clear scope.
        </p>
      </div>
      <ul class="process-list">
        <li><strong>Inspect</strong> condition, defects, risks</li>
        <li><strong>Correct</strong> paint, gelcoat, defects</li>
        <li><strong>Protect</strong> ceramic &amp; film where appropriate</li>
        <li><strong>Maintain</strong> programs you can schedule</li>
      </ul>
    </div>
  </section>
  <section class="u-section cta-band">
    <div class="u-container cta-band__inner">
      <div>
        <h2>Discuss your vessel, aircraft, or collection</h2>
        <p class="u-muted">Call, email, or message — we respond promptly.</p>
      </div>
      <div class="cta-band__actions">
        <a class="u-btn" href="/contact">Contact</a>
        <a class="u-btn u-btn--ghost" href={SITE.instagramUrl} target="_blank" rel="noopener noreferrer">
          Instagram
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initDomainCards } from '../scripts/domain-cards';
  import { initDomainReveal } from '../scripts/domain-reveal';
  import { initHeroMetrics } from '../scripts/hero-metrics';
  initDomainCards();
  initDomainReveal();
  initHeroMetrics();
</script>

<style>
  .hero {
    position: relative;
    z-index: 2;
    /* Shared with WaveDivider strip + metrics band height */
    --hero-wave-strip-height: clamp(12.5rem, 21vw, 17rem);
    /*
      Fill the visible viewport so the wave sits flush with the bottom edge on load
      (92vh + 900px cap left a strip of .domains backdrop showing — scales wrong per display).
      100vh fallback; 100dvh tracks dynamic browser chrome (mobile toolbars, etc.).
    */
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: flex-start;
    /* Copy lives in the upper “safe zone”; wave/metrics stay absolutely at the bottom */
    padding-bottom: clamp(3rem, 8vw, 5rem);
    overflow-x: hidden;
  }

  @media (max-width: 480px) {
    .hero {
      --hero-wave-strip-height: clamp(10.5rem, 26vw, 14rem);
    }
  }

  /*
    Wave strip = CSS wave layers only; metrics sit above .hero__blue-veil (sibling) so stats stay legible.
  */
  .hero__waves {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    pointer-events: none;
    line-height: normal;
    box-sizing: border-box;
  }

  /* Very light brand navy over photo + waves; under headline/metrics/buttons */
  .hero__blue-veil {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: rgba(16, 33, 53, 0.11);
  }

  .hero__waves :global(.waves-wrap) {
    display: block;
    line-height: 0;
    overflow: hidden;
  }

  .hero__metrics {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--hero-wave-strip-height);
    z-index: 4;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    line-height: normal;
    overflow: visible;
    padding: 0 0 0.5rem;
    box-sizing: border-box;
    pointer-events: none;
  }

  .hero__metrics-inner {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    width: 100%;
    max-width: 56rem;
    padding-inline: var(--space-sm);
    padding-bottom: 0.4rem;
    line-height: normal;
    overflow: visible;
    transform: translateY(-1cm);
  }

  .hero__metric {
    text-align: center;
    padding: 0.35rem 0.4rem 0.45rem;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    box-sizing: border-box;
    overflow: visible;
  }

  .hero__metric:last-child {
    border-right: none;
  }

  @media (max-width: 639px) {
    .hero__metrics-inner {
      padding-inline: 0.25rem;
    }

    .hero__metric {
      padding-inline: 0.1rem;
    }
  }

  .hero__metric-value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 3vw, 1.75rem);
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .hero__metric-suffix {
    font-weight: 600;
    font-size: 0.7em;
    margin-inline-start: 0.02em;
    opacity: 1;
  }

  .hero__metric-label {
    margin: 0.28rem 0 0;
    padding-bottom: 0.08rem;
    font-family: var(--font-ui);
    font-size: clamp(0.54rem, 1.15vw, 0.72rem);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(239, 236, 231, 0.55);
    line-height: 1.35;
    overflow: visible;
  }

  .hero__metric--text {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
  }

  .hero__metric-value--text {
    font-family: var(--font-hero);
    font-size: clamp(1rem, 2.6vw, 1.5rem);
    font-weight: 200;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-variant-numeric: normal;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    isolation: isolate;
    /* Fills the strip above the photo when the image is nudged down */
    background-color: #030303;
  }

  /*
    Feather that extends past the gap and onto the photo so the image top edge dissolves instead of cutting off.
    Taller band + slower alpha ramp = overlap well into the jet frame under the scrim.
  */
  .hero__media::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: clamp(7.5rem, 36vmin, 17rem);
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      #030303 0%,
      #030303 10%,
      rgba(3, 3, 3, 0.94) 20%,
      rgba(5, 5, 6, 0.62) 38%,
      rgba(8, 8, 9, 0.32) 58%,
      rgba(12, 12, 13, 0.12) 76%,
      rgba(16, 16, 17, 0.04) 90%,
      transparent 100%
    );
  }

  /*
    Unified veil: light blur across the feather + photo, plus a gentle gradient tint so it reads as one surface.
    Sits under .hero__scrim (text legibility stays on top).
  */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    backdrop-filter: blur(3px) saturate(1.06);
    -webkit-backdrop-filter: blur(3px) saturate(1.06);
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.32) 0%,
      rgba(4, 4, 5, 0.14) 22%,
      rgba(8, 8, 10, 0.06) 42%,
      rgba(6, 6, 8, 0.04) 58%,
      rgba(4, 4, 6, 0.1) 78%,
      rgba(2, 2, 4, 0.2) 100%
    );
  }

  .hero__img {
    position: relative;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* When cover crops only top/bottom, horizontal % does nothing — translateX always shifts the frame */
    object-position: 58% top;
    /* Slightly less X than before (“back” left a touch) + light zoom to tighten framing */
    transform: translate3d(
      clamp(0.72rem, 2.35vw, 2.05rem),
      clamp(0.65rem, 2vmin, 1.75rem),
      0
    )
      scale(1.055);
    transform-origin: center top;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media::after {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .hero__img {
      transform: translate3d(clamp(0.72rem, 2.35vw, 2.05rem), 0, 0) scale(1.055);
      object-position: 58% 10%;
    }

    .hero__metrics-inner {
      transform: none;
    }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 3;
    /*
      Neutral top band (black / charcoal) — not navy — so type reads like the reference,
      then fade for the aircraft and a soft lift at the bottom for the wave/metrics.
    */
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.97) 0%,
      rgba(0, 0, 0, 0.94) 7%,
      rgba(10, 10, 12, 0.82) 15%,
      rgba(22, 22, 24, 0.52) 26%,
      rgba(32, 32, 34, 0.22) 38%,
      rgba(40, 40, 42, 0.06) 48%,
      rgba(28, 28, 30, 0.1) 62%,
      rgba(18, 18, 20, 0.35) 78%,
      rgba(10, 10, 12, 0.72) 92%,
      rgba(4, 4, 5, 0.88) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 5;
    align-self: flex-start;
    box-sizing: border-box;
    /* margin-top shifts the whole cluster in the flex layout (padding alone was easy to miss) */
    margin-top: clamp(1.5rem, 5vw, 3.25rem);
    padding-top: calc(var(--header-h) + var(--space-md));
    padding-bottom: var(--space-lg);
    max-width: 42rem;
  }

  /* Match header Instagram / accent chrome */
  .hero__content > .u-eyebrow {
    color: var(--color-accent);
    letter-spacing: 0.2em;
  }

  .hero__title {
    font-style: normal;
  }

  /* Same specificity as global, but in this page’s CSS so it always applies after the reset bundle */
  :global(section.hero .hero__content > h1.hero__title) {
    letter-spacing: 0;
    word-spacing: normal;
  }

  .hero__title em {
    font-style: italic;
    color: #fff;
  }

  .hero__lede {
    font-size: 1.0625rem;
    color: var(--color-cream-muted);
    margin-bottom: var(--space-md);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero__actions .hero__cta {
    background: rgba(239, 236, 231, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.32);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .hero__actions .hero__cta:hover {
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-navy);
  }

  .domains {
    /* Vivid layered backdrop so glass cards read clearly (glassmorphism guide) */
    background:
      radial-gradient(ellipse 100% 70% at 14% 22%, rgba(56, 115, 195, 0.22) 0%, transparent 52%),
      radial-gradient(ellipse 85% 55% at 88% 68%, rgba(48, 110, 95, 0.16) 0%, transparent 48%),
      radial-gradient(circle at 72% 8%, rgba(196, 184, 150, 0.07) 0%, transparent 38%),
      linear-gradient(168deg, #0c1a2f 0%, #0a1628 40%, #0e2136 100%);
    /*
      Slight upward overlap: closes the hairline gap under the wave. .hero stays z-index: 2 so this
      doesn’t paint over the wave/metrics strip — only tucks under the hero’s bottom edge.
    */
    margin-top: -6px;
    padding-top: calc(var(--space-xl) + 6px);
    position: relative;
    z-index: 1;
  }

  .domains > .u-container {
    position: relative;
    z-index: 1;
  }

  .domains__intro {
    max-width: 36rem;
    margin-bottom: var(--space-lg);
  }

  .domains__grid {
    margin-top: var(--space-md);
    display: grid;
    gap: clamp(0.35rem, 0.9vw, 0.65rem);
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .domains__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card-domain {
    display: flex;
    flex-direction: column;
    position: relative;
    padding: clamp(1.5rem, 3.2vw, 2.15rem);
    text-decoration: none;
    color: inherit;
    /* Default = Automotive: sharp top-left, large top-right; Marine & Aviation override */
    border-radius: 1rem clamp(3rem, 8.5vw, 4.75rem) 1.125rem 1.125rem;
    border: 2px solid var(--glass-border, rgba(255, 255, 255, 0.22));
    backdrop-filter: var(--glass-blur-card, blur(40px) saturate(1.42));
    -webkit-backdrop-filter: var(--glass-blur-card, blur(40px) saturate(1.42));
    box-shadow:
      var(--glass-shadow-diffuse, 0 0 4rem rgba(0, 0, 0, 0.3)),
      0 8px 40px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.12);
    aspect-ratio: 3 / 4;
    max-height: min(34rem, 74vh);
    min-height: 18rem;
    transition:
      transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s ease,
      background 0.35s ease;
  }

  @media (max-width: 639px) {
    .card-domain {
      aspect-ratio: 4 / 3;
      max-height: none;
      min-height: 15rem;
    }
  }

  .card-domain--marine {
    background: linear-gradient(
      155deg,
      rgba(56, 120, 200, 0.22) 0%,
      rgba(20, 45, 88, 0.18) 45%,
      rgba(10, 22, 48, 0.24) 100%
    );
    border-color: rgba(180, 215, 255, 0.32);
    border-radius: clamp(3rem, 8.5vw, 4.75rem) 1rem 1.125rem 1.125rem;
  }

  .card-domain--aviation {
    background: linear-gradient(
      165deg,
      rgba(90, 160, 130, 0.2) 0%,
      rgba(35, 72, 62, 0.18) 50%,
      rgba(18, 42, 38, 0.22) 100%
    );
    border-color: rgba(195, 235, 210, 0.34);
    border-radius: 1rem 1rem 1.125rem 1.125rem;
    box-shadow:
      0 8px 40px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(220, 245, 230, 0.22),
      inset 0 -1px 0 rgba(0, 0, 0, 0.1);
  }

  .card-domain--automotive {
    background: linear-gradient(
      168deg,
      rgba(255, 252, 248, 0.28) 0%,
      rgba(248, 238, 228, 0.22) 48%,
      rgba(235, 224, 210, 0.26) 100%
    );
    border-color: rgba(255, 255, 255, 0.42);
    backdrop-filter: var(--glass-blur-card, blur(40px) saturate(1.25));
    -webkit-backdrop-filter: var(--glass-blur-card, blur(40px) saturate(1.25));
    box-shadow:
      0 8px 40px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 -1px 0 rgba(16, 33, 53, 0.08);
  }

  /* Scroll-into-view reveal (IntersectionObserver adds `.active`) */
  .card-domain[data-domain-reveal] {
    opacity: 0.3;
    transform: scale(0.95) translateY(30px);
    filter: brightness(0.6);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease,
      filter 0.6s ease,
      box-shadow 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s ease,
      background 0.35s ease;
  }

  .card-domain[data-domain-reveal].active {
    opacity: 1;
    transform: scale(1) translateY(0);
    filter: brightness(1);
  }

  .card-domain[data-domain-reveal]:not(.active):hover {
    transform: scale(0.95) translateY(30px);
    box-shadow:
      var(--glass-shadow-diffuse, 0 0 4rem rgba(0, 0, 0, 0.3)),
      0 8px 40px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.12);
  }

  .card-domain[data-domain-reveal].active:hover {
    transform: translateY(-10px);
    box-shadow:
      var(--glass-shadow-diffuse, 0 0 4rem rgba(0, 0, 0, 0.3)),
      0 28px 60px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 -1px 0 rgba(0, 0, 0, 0.12);
    border-color: rgba(255, 255, 255, 0.42);
  }

  .card-domain[data-domain-reveal].active.card-domain--automotive:hover {
    box-shadow:
      0 26px 56px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.65),
      inset 0 -1px 0 rgba(16, 33, 53, 0.1);
    border-color: rgba(255, 255, 255, 0.52);
  }

  .card-domain[data-domain-reveal].active:active {
    transform: translateY(-4px);
  }

  .card-domain:hover {
    transform: translateY(-10px);
    box-shadow:
      var(--glass-shadow-diffuse, 0 0 4rem rgba(0, 0, 0, 0.3)),
      0 28px 60px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 -1px 0 rgba(0, 0, 0, 0.12);
    border-color: rgba(255, 255, 255, 0.42);
  }

  .card-domain--automotive:hover {
    box-shadow:
      0 26px 56px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.65),
      inset 0 -1px 0 rgba(16, 33, 53, 0.1);
    border-color: rgba(255, 255, 255, 0.52);
  }

  .card-domain:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .card-domain:active {
    transform: translateY(-4px);
  }

  .card-domain__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.8vw, 1.85rem);
    font-weight: 500;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.35);
  }

  .card-domain--automotive .card-domain__title {
    color: var(--color-navy);
    text-shadow: 0 1px 10px rgba(255, 255, 255, 0.45);
  }

  .card-domain__visual {
    flex: 1;
    min-height: clamp(5.5rem, 20vw, 8.5rem);
    border-radius: clamp(0.75rem, 2vw, 1.125rem);
    margin-block: 0.25rem 1rem;
    border: 2px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      0 0 2.5rem rgba(0, 0, 0, 0.18),
