    word-spacing: normal;
    line-height: 1.15;
    color: var(--color-cream);
    margin-bottom: var(--space-md);
    text-shadow: none;
  }

  .domains.index-atmos .domains__header .domains__intro {
    max-width: 36rem;
    margin-inline: auto;
    margin-bottom: 0;
    color: rgba(175, 192, 218, 0.82);
