---
import BaseLayout from '../layouts/BaseLayout.astro';
// import WaveDivider from '../components/WaveDivider.astro';
import { SITE } from '../site';
import aviationTn from '../../assets/aviation-tn.jpg';
import heroImage from '../../assets/yacht6.png';
import yacht1 from '../../assets/yacht1.png';
---

<BaseLayout title={SITE.shortName} transparentHeader={true} dataHomeLoadIntro={true}>
  <section class="hero">
    <div class="hero__media">
      <img
        src={heroImage.src}
        alt="Luxury yacht exterior — precision detailing and protection"
        width={heroImage.width}
        height={heroImage.height}
        fetchpriority="high"
        decoding="sync"
        class="hero__img"
      />
      <div class="hero__scrim" aria-hidden="true"></div>
    </div>
    <!-- Wave strip paused
    <div class="hero__waves">
      <WaveDivider />
    </div>
    -->
    <div class="hero__metrics" aria-label="Company highlights" role="region">
      <div class="hero__metrics-inner u-container">
        <div class="hero__metric" data-count-row>
          <p class="hero__metric-value">
            <span class="hero__metric-num" data-count-to="5">0</span>
          </p>
          <p class="hero__metric-label">Years of excellence</p>
        </div>
        <div class="hero__metric">
          <p class="hero__metric-value hero__metric-value--text">Licensed & Insured</p>
        </div>
        <div class="hero__metric" data-count-row>
          <p class="hero__metric-value">
            <span class="hero__metric-num" data-count-to="100">0</span><span class="hero__metric-suffix">+</span>
          </p>
          <p class="hero__metric-label">Projects completed</p>
        </div>
      </div>
    </div>
    <div class="hero__content u-container">
      <h1 class="hero__title">
        <span class="hero-load-headline__part hero-load-headline__part--1">One standard.</span>
        <span class="hero-load-headline__part hero-load-headline__part--2"> Three domains.</span>
      </h1>
      <p class="hero__domain-links" aria-label="Service domains">
        <a href="/marine">Marine</a>
        <span aria-hidden="true">•</span>
        <a href="/aviation">Aviation</a>
        <span aria-hidden="true">•</span>
        <a href="/automotive">Automotive</a>
      </p>
      <!--
      <div class="hero__actions">
        <a class="u-btn hero__cta" href="/contact">
          <svg class="hero__cta-border" aria-hidden="true" focusable="false">
            <rect x="0" y="0" width="100%" height="100%" rx="6" ry="6" fill="none"></rect>
          </svg>
          <span class="hero__cta-label">Request a quote</span>
        </a>
      </div>
      -->
    </div>
  </section>
  <section class="u-section domains index-atmos">
    <div class="u-container">
      <div class="domains__header">
        <p class="u-eyebrow" data-domains-abyss>Domains</p>
        <p class="u-muted domains__intro" data-domains-abyss>
          The same inspection-driven process — scaled to gelcoat, airframe finishes, and high-end automotive
          paint systems.
        </p>
      </div>
      <div class="domains__grid">
        <a
          class="card-domain card-domain--marine"
          href="/marine"
          data-domain-card
          data-domain-reveal
        >
          <div class="card-domain__content">
            <h3 class="card-domain__title">Marine</h3>
            <div class="card-domain__visual card-domain__visual--marine" aria-hidden="true">
              <img
                class="card-domain__img"
                src={yacht1.src}
                alt=""
                width={yacht1.width}
                height={yacht1.height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="card-domain__body">
              <p>
                Luxury center consoles to superyachts — gelcoat, brightwork, interiors, and show-ready prep.
              </p>
            </div>
            <span class="card-domain__cta">Explore</span>
          </div>
        </a>
        <a
          class="card-domain card-domain--aviation"
          href="/aviation"
          data-domain-card
          data-domain-reveal
        >
          <div class="card-domain__content">
            <h3 class="card-domain__title">Aviation</h3>
            <div class="card-domain__visual card-domain__visual--aviation" aria-hidden="true">
              <img
                class="card-domain__img"
                src={aviationTn.src}
                alt=""
                width={aviationTn.width}
                height={aviationTn.height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="card-domain__body">
              <p>Private aircraft exteriors and cabins — discretion, scheduling, and finish integrity first.</p>
            </div>
            <span class="card-domain__cta">Explore</span>
          </div>
        </a>
        <a
          class="card-domain card-domain--automotive"
          href="/automotive"
          data-domain-card
          data-domain-reveal
        >
          <div class="card-domain__content">
            <h3 class="card-domain__title">Automotive</h3>
            <div class="card-domain__visual card-domain__visual--automotive" aria-hidden="true"></div>
            <div class="card-domain__body">
              <p>High-end paint correction, ceramic coating, and maintenance for exceptional road cars.</p>
            </div>
            <span class="card-domain__cta">Explore</span>
          </div>
        </a>
      </div>
    </div>
  </section>
  <section class="u-section u-section--tight trust index-atmos">
    <div class="u-container trust__inner">
      <p>Serving South Florida</p>
      <p>Private clients</p>
      <p>Licensed & Insured</p>
    </div>
  </section>
  <section class="u-section process-preview index-atmos">
    <div class="u-container process-preview__grid">
      <div>
        <p class="u-eyebrow">Process</p>
        <h2>Inspection to longevity</h2>
        <p class="u-muted">
          Every engagement begins with surfaces, environment, and how you use the asset — then we build a
          clear scope.
        </p>
      </div>
      <ul class="process-list">
        <li><strong>Inspect</strong> condition, defects, risks</li>
        <li><strong>Correct</strong> paint, gelcoat, defects</li>
        <li><strong>Protect</strong> ceramic &amp; film where appropriate</li>
        <li><strong>Maintain</strong> programs you can schedule</li>
      </ul>
    </div>
  </section>
  <section class="u-section cta-band index-atmos">
    <div class="u-container cta-band__inner">
      <div>
        <h2>Discuss your vessel, aircraft, or collection</h2>
        <p class="u-muted">Call, email, or message — we respond promptly.</p>
      </div>
      <div class="cta-band__actions">
        <a class="u-btn" href="/contact">Contact</a>
        <a class="u-btn u-btn--ghost" href={SITE.instagramUrl} target="_blank" rel="noopener noreferrer">
          Instagram
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initLoadDebug } from '../scripts/load-debug';
  import { initDomainCards } from '../scripts/domain-cards';
  import { initDomainReveal } from '../scripts/domain-reveal';
  import { initHeroMetrics } from '../scripts/hero-metrics';
  initLoadDebug();
  initDomainCards();
  initDomainReveal();
  initHeroMetrics();
</script>

<style>
  .hero {
    position: relative;
    z-index: 2;
    /* Shared with WaveDivider strip + metrics band height */
    --hero-wave-strip-height: clamp(12.5rem, 21vw, 17rem);
    /*
      Fill the visible viewport so the wave sits flush with the bottom edge on load
      (92vh + 900px cap left a strip of .domains backdrop showing — scales wrong per display).
      100vh fallback; 100svh avoids a second layout pass when dynamic viewport units settle (felt like a “double load” on reload).
    */
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-start;
    /* Copy lives in the upper “safe zone”; wave/metrics stay absolutely at the bottom */
    padding-bottom: clamp(3rem, 8vw, 5rem);
    overflow-x: hidden;
    /* Intro scales `.hero__media`; without vertical clipping that paint can widen root overflow and flash a second scrollbar (Safari). */
    overflow-y: hidden;
  }

  @supports (overflow: clip) {
    .hero {
      overflow-y: clip;
    }
  }

  @media (max-width: 480px) {
    .hero {
      --hero-wave-strip-height: clamp(10.5rem, 26vw, 14rem);
    }
  }

  /*
    Wave strip = CSS wave layers only; metrics sit above it (higher z-index) so stats stay legible.
  */
  .hero__waves {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    pointer-events: none;
    line-height: normal;
    box-sizing: border-box;
  }

  .hero__waves :global(.waves-wrap) {
    display: block;
    line-height: 0;
    overflow: hidden;
  }

  .hero__metrics {
    position: absolute;
    left: 0;
    right: 0;
    /* ~1 inch up from the viewport bottom so the strip sits higher on the hero */
    bottom: clamp(4.25rem, 9vmin, 6rem);
    height: var(--hero-wave-strip-height);
    z-index: 4;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    line-height: normal;
    overflow: visible;
    padding: 0 0 0.5rem;
    box-sizing: border-box;
    pointer-events: none;
  }

  .hero__metrics-inner {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 0;
    width: 100%;
    max-width: 56rem;
    padding-inline: var(--space-sm);
    padding-bottom: 0.4rem;
    line-height: normal;
    overflow: visible;
    transform: translate3d(0, -1cm, 0);
  }

  /*
    Homepage load choreography (reference sequence): blur resolve → headline parts → domains →
    stats rise → nav fade. Scoped to `html[data-home-load-intro]` so other pages are unaffected.
  */
  @keyframes homeHeroImgIntro {
    from {
      opacity: 0.25;
      filter: blur(5px) brightness(0.55);
    }

    to {
      opacity: 1;
      filter: blur(0) brightness(1);
    }
  }

  @keyframes homeWordRise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes homeFadeOnly {
    to {
      opacity: 1;
    }
  }

  @keyframes homeStatRise {
    to {
      opacity: 1;
      transform: translate3d(0, -1cm, 0);
    }
  }

  html[data-home-load-intro] .hero__media {
    transform: none;
    animation: none;
  }

  html[data-home-load-intro] .hero__img {
    opacity: 0;
    filter: blur(5px) brightness(0.55);
    animation: homeHeroImgIntro 2.1s cubic-bezier(0.25, 0.1, 0.25, 1) 0s forwards;
  }

  html[data-home-load-intro] .hero-load-headline__part {
    display: inline-block;
    opacity: 0;
    transform: translateY(22px);
  }

  /* Simplified sequence: text follows shortly after the softened hero settle. */
  html[data-home-load-intro] .hero-load-headline__part--1 {
    animation: homeWordRise 0.75s cubic-bezier(0.25, 0.1, 0.25, 1) 0.25s forwards;
  }

  html[data-home-load-intro] .hero-load-headline__part--2 {
    animation: homeWordRise 0.75s cubic-bezier(0.25, 0.1, 0.25, 1) 1s forwards;
  }

  html[data-home-load-intro] .hero__domain-links {
    opacity: 0;
    animation: homeFadeOnly 0.62s cubic-bezier(0.25, 0.1, 0.25, 1) 1.5s forwards;
  }

  html[data-home-load-intro] .hero__metrics-inner {
    opacity: 0;
    transform: translate3d(0, calc(-1cm + 12px), 0);
    animation: homeStatRise 0.62s cubic-bezier(0.25, 0.1, 0.25, 1) 1.5s forwards;
  }

  html[data-home-load-intro] .site-header--transparent {
    opacity: 0;
    animation: homeFadeOnly 0.62s cubic-bezier(0.25, 0.1, 0.25, 1) 2.5s forwards;
  }

  .hero__metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.35rem 0.4rem 0.45rem;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    box-sizing: border-box;
    overflow: visible;
  }

  .hero__metric[data-count-row] {
    gap: 0.28rem;
  }

  .hero__metric:last-child {
    border-right: none;
  }

  @media (max-width: 639px) {
    .hero__metrics-inner {
      padding-inline: 0.25rem;
    }

    .hero__metric {
      padding-inline: 0.1rem;
    }
  }

  @media (max-width: 820px) and (orientation: portrait) {
    .hero {
      --hero-wave-strip-height: clamp(13.5rem, 42vw, 17.5rem);
    }

    .hero__metrics {
      bottom: clamp(5.4rem, 12vmin, 7.25rem);
      padding-bottom: 0;
    }

    .hero__metrics-inner {
      grid-template-columns: 1fr;
      gap: 0.95rem;
      max-width: 21rem;
      padding-bottom: 0.15rem;
    }

    .hero__metric {
      position: relative;
      border-right: none;
      border-bottom: none;
      padding: 0.48rem 0.25rem 0.52rem;
    }

    .hero__metric::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: -0.48rem;
      width: min(70%, 14.5rem);
      transform: translateX(-50%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    }

    .hero__metric:last-child {
      padding-bottom: 0.05rem;
    }

    .hero__metric:last-child::after {
      content: none;
    }

    .hero__metric-value {
      font-size: calc(clamp(1.1rem, 3vw, 1.75rem) + 0.17rem);
    }

    .hero__metric-value--text {
      font-size: calc(clamp(0.88rem, 2.2vw, 1.2rem) + 0.17rem);
    }

    .hero__metric-label {
      font-size: calc(clamp(0.54rem, 1.15vw, 0.72rem) + 0.17rem);
    }
  }

  .hero__metric-value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 3vw, 1.75rem);
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .hero__metric-suffix {
    font-weight: 600;
    font-size: 0.7em;
    margin-inline-start: 0.02em;
    opacity: 1;
  }

  .hero__metric-label {
    margin: 0;
    padding-bottom: 0.08rem;
    font-family: var(--font-ui);
    font-size: clamp(0.54rem, 1.15vw, 0.72rem);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(239, 236, 231, 0.55);
    line-height: 1.35;
    overflow: visible;
  }

  .hero__metric-value--text {
    font-family: var(--font-hero);
    font-size: clamp(0.88rem, 2.2vw, 1.2rem);
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: none;
    font-variant-numeric: normal;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(180deg, #1c1e22 0%, #141518 14%, #101114 38%, #0b0c0e 100%);
  }

  /* No dedicated header feather overlay. */
  .hero__media::before {
    content: none;
  }

  .hero__img {
    position: relative;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* When cover crops only top/bottom, horizontal % does nothing — translateX always shifts the frame */
    object-position: 46% top;
    /* Nudge frame + zoom for hero crop (tune per asset). */
    transform: translate3d(
      clamp(-0.35rem, -0.85vw, 0.85rem),
      clamp(0rem, 0.35vmin, 0.45rem),
      0
    )
      scale(1.075);
    transform-origin: center top;
  }

  /*
    Tablet/mobile: keep more of the top of the source photo visible. The desktop crop nudges
    downward and zooms in more aggressively, which can read as "cut off" on iPad.
  */
  @media (max-width: 1200px) {
    .hero__img {
      object-position: 48% top;
      /*
        iPad/tablet overscan: push the frame upward so the top edge always stays photo-filled.
      */
      transform: translate3d(clamp(-0.2rem, -0.5vw, 0.3rem), -1.15rem, 0) scale(1.05);
    }
  }

  @media (max-width: 820px) {
    .hero__img {
      object-position: 50% top;
      transform: translate3d(0, -1.05rem, 0) scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__img {
      transform: translate3d(clamp(-0.35rem, -0.85vw, 0.85rem), 0, 0) scale(1.075);
      object-position: 46% 10%;
    }

    html[data-home-load-intro] .hero__media,
    html[data-home-load-intro] .hero__img {
      animation: none !important;
      filter: none !important;
      opacity: 1 !important;
    }

    html[data-home-load-intro] .hero__media {
      transform: none !important;
    }

    html[data-home-load-intro] .hero-load-headline__part {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }

    html[data-home-load-intro] .hero__domain-links {
      opacity: 1 !important;
      animation: none !important;
    }

    html[data-home-load-intro] .hero__metrics-inner {
      opacity: 1 !important;
      transform: translate3d(0, -1cm, 0) !important;
      animation: none !important;
    }

    html[data-home-load-intro] .site-header--transparent {
      opacity: 1 !important;
      animation: none !important;
    }

    .hero__actions .hero__cta-border rect {
      transition: none !important;
      stroke: var(--color-accent) !important;
      stroke-width: 1.5 !important;
      stroke-dasharray: 422, 0 !important;
      stroke-dashoffset: 0 !important;
    }

    .hero__actions .hero__cta:hover .hero__cta-border rect,
    .hero__actions .hero__cta:focus-visible .hero__cta-border rect {
      stroke-width: 5 !important;
      stroke-dasharray: 15, 310 !important;
      stroke-dashoffset: 48 !important;
    }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 3;
    /*
      Vertical base for type; horizontal top layer keeps the left (yacht) lighter and adds depth
      toward the dock on the right.
    */
    background:
      linear-gradient(
        to right,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0) 44%,
        rgba(0, 0, 0, 0.22) 68%,
        rgba(0, 0, 0, 0.42) 100%
      ),
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0) 8%,
        rgba(0, 0, 0, 0.06) 15%,
        rgba(0, 0, 0, 0.18) 26%,
        rgba(0, 0, 0, 0.26) 38%,
        rgba(0, 0, 0, 0.28) 52%,
        rgba(0, 0, 0, 0.34) 62%,
        rgba(0, 0, 0, 0.42) 74%,
        rgba(0, 0, 0, 0.56) 88%,
        rgba(0, 0, 0, 0.68) 100%
      );
  }

  .hero__content {
    position: relative;
    z-index: 5;
    align-self: flex-start;
    box-sizing: border-box;
    /* margin-top shifts the whole cluster in the flex layout (padding alone was easy to miss) */
    margin-top: calc(clamp(1.5rem, 5vw, 3.25rem) + 6rem);
    padding-top: calc(var(--header-h) + var(--space-md));
    padding-bottom: var(--space-lg);
    max-width: 56rem;
  }

  /* Match header Instagram / accent chrome */
  .hero__content > .u-eyebrow {
    color: var(--color-accent);
    letter-spacing: 0.2em;
  }

  .hero__title {
    text-align: center;
  }

  .hero__title em {
    font-style: italic;
    color: #fff;
  }

  .hero__lede {
    font-size: 1.0625rem;
    color: var(--color-cream-muted);
    margin-bottom: var(--space-md);
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
  }

  .hero__domain-links {
    margin: 0 0 var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 1.3vw, 0.95rem);
    font-family: var(--font-ui);
    font-size: clamp(0.72rem, 1.55vw, 0.96rem);
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(239, 236, 231, 0.72);
    line-height: 1.35;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.42);
  }

  .hero__domain-links a,
  .hero__domain-links a:hover,
  .hero__domain-links a:focus-visible {
    color: inherit;
    text-decoration: none;
  }

  .hero__domain-links a {
    letter-spacing: inherit;
  }

  .hero__domain-links span {
    opacity: 0.66;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /*
    Hero CTA SVG: rounded rect rx/ry = --radius-sm so stroke corners match .u-btn; btn-1 stroke rest vs hover.
  */
  .hero__actions .hero__cta {
    position: relative;
    z-index: 0;
    overflow: visible;
    border-radius: var(--radius-sm);
    border: none;
    color: var(--color-cream-muted);
    font-size: 0.8125rem;
    font-weight: 900;
    letter-spacing: 1px;
    text-shadow: none;
    background:
      linear-gradient(
        152deg,
        rgba(255, 255, 255, 0.1) 0%,
        rgba(255, 255, 255, 0.03) 32%,
        transparent 52%,
        transparent 68%,
        rgba(140, 165, 210, 0.08) 100%
      ),
      rgba(0, 0, 0, 0.3);
    box-shadow:
      0 0 1px rgba(196, 184, 150, 0.35),
      0 0 22px rgba(196, 184, 150, 0.2),
      0 0 44px rgba(239, 236, 231, 0.08),
      0 0 20px rgba(255, 255, 255, 0.08),
      inset 0 0 18px rgba(255, 255, 255, 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    text-decoration: none;
    transition:
      background 0.35s linear,
      color 0.35s linear,
      text-shadow 0.35s linear,
      box-shadow 0.35s linear;
  }

  /* .btn-1 svg */
  .hero__actions .hero__cta-border {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .hero__actions .hero__cta-border rect {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    stroke-dasharray: 422, 0;
    stroke-dashoffset: 0;
    transition: all 0.35s linear;
  }

  .hero__actions .hero__cta-label {
    position: relative;
    z-index: 1;
  }

  /* .btn-1:hover (+ outer glow; type metrics match default) */
  .hero__actions .hero__cta:hover,
