  .card-domain__visual {
    flex: 1;
    min-height: clamp(5.5rem, 20vw, 8.5rem);
    border-radius: clamp(0.75rem, 2vw, 1.125rem);
    margin-block: 0.25rem 1rem;
    border: 2px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      0 0 2.5rem rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      inset 0 -12px 32px rgba(0, 0, 0, 0.25);
    backdrop-filter: var(--glass-blur-pane, blur(18px) saturate(1.2));
    -webkit-backdrop-filter: var(--glass-blur-pane, blur(18px) saturate(1.2));
    overflow: hidden;
  }

  /* Photo panes: same neutral chrome on all three (matches Camden card, not per-vertical tint) */
  .card-domain__visual--marine,
  .card-domain__visual--aviation {
    position: relative;
    padding: 0;
    background: rgba(24, 24, 26, 0.55);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .card-domain__visual--marine::after,
  .card-domain__visual--aviation::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
