---
import BaseLayout from '../layouts/BaseLayout.astro';
// import WaveDivider from '../components/WaveDivider.astro';
import { SITE } from '../site';
import aviationTn from '../../assets/aviation/jethero3.png';
import heroImage from '../../assets/yacht6.png';
import car1 from '../../assets/automotive/car1.png';
import car2 from '../../assets/car.2.png';
import jet2 from '../../assets/jet-2.png';
import yacht1 from '../../assets/yacht1.png';
import yacht2 from '../../assets/yacht2.png';
---

<BaseLayout title={SITE.shortName}>
  <section class="hero">
    <div class="hero__media">
      <img
        src={heroImage.src}
        alt="Luxury yacht exterior — precision detailing and protection"
        width={heroImage.width}
        height={heroImage.height}
        fetchpriority="high"
        decoding="sync"
        class="hero__img"
      />
      <div class="hero__scrim" aria-hidden="true"></div>
    </div>
    <!-- Wave strip paused
    <div class="hero__waves">
      <WaveDivider />
    </div>
    -->
    <div class="hero__metrics" aria-label="Company highlights" role="region">
      <div class="hero__metrics-inner u-container">
        <div class="hero__metric" data-count-row>
          <p class="hero__metric-value">
            <span class="hero__metric-num" data-count-to="5">0</span>
          </p>
          <p class="hero__metric-label">Years of excellence</p>
        </div>
        <div class="hero__metric">
          <p class="hero__metric-value hero__metric-value--text">Licensed & Insured</p>
        </div>
        <div class="hero__metric" data-count-row>
          <p class="hero__metric-value">
            <span class="hero__metric-num" data-count-to="100">0</span><span class="hero__metric-suffix">+</span>
          </p>
          <p class="hero__metric-label">Projects completed</p>
        </div>
      </div>
    </div>
    <div class="hero__content u-container">
      <h1 class="hero__title">
        <span class="hero-load-headline__part hero-load-headline__part--1">One standard.</span>
        <span class="hero-load-headline__part hero-load-headline__part--2"> Three domains.</span>
      </h1>
      <p class="hero__domain-links" aria-label="Service domains">
        <a href="/#marine">Marine</a>
        <span aria-hidden="true">•</span>
        <a href="/#aviation">Aviation</a>
        <span aria-hidden="true">•</span>
        <a href="/#automotive">Automotive</a>
      </p>
      <!--
      <div class="hero__actions">
        <a class="u-btn hero__cta" href="/contact">
          <svg class="hero__cta-border" aria-hidden="true" focusable="false">
            <rect x="0" y="0" width="100%" height="100%" rx="6" ry="6" fill="none"></rect>
          </svg>
          <span class="hero__cta-label">Request a quote</span>
        </a>
      </div>
      -->
    </div>
  </section>
  <!-- Enables domains entry animation before first paint of bands. -->
  <script is:inline>
    document.documentElement.classList.add('domains-drift-js');
  </script>
  <section class="u-section domains domains-drift index-atmos" aria-label="Service domains">
    <div class="u-container domains-drift__grid">
      <a class="domains-spine__link" href="#marine" data-spine="marine">
        <span class="domains-spine__label">Marine</span>
        <span class="domains-spine__bar" aria-hidden="true"></span>
        <span class="domains-spine__node" aria-hidden="true"></span>
      </a>
    <article id="marine" class="domains-band" aria-label="Marine detailing">
      <div class="domains-band__stage" data-drift-scrub style="--drift-exit: 0;">
        <div class="domains-band__inner u-container" data-drifts-in>
        <div class="domains-band__layout">
          <figure class="domains-band__fig" aria-hidden="true">
            <div class="domains-band__plate" transition:name="domain-marine-hero">
              <div class="rellax" data-rellax-speed="-0.42">
                <img
                  src={yacht1.src}
                  alt=""
                  width={yacht1.width}
                  height={yacht1.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="domains-band__float rellax" data-rellax-speed="0.26">
              <img
                src={yacht2.src}
                alt=""
                width={yacht2.width}
                height={yacht2.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
          <div class="domains-band__text">
            <p class="domains-band__eyebrow">Marine</p>
            <h3 class="domains-band__title">Gelcoat to brightwork</h3>
            <p class="domains-band__lede">
              Luxury center consoles to superyachts — gelcoat, brightwork, interiors, and show-ready prep.
            </p>
            <a
              class="domains-drift__explore card-domain card-domain--marine card-domain--mini"
              href="/marine"
            >
              <span class="card-domain__content">
                <span class="card-domain__title">Marine</span>
                <div class="card-domain__body">
                  <p>
                    Luxury center consoles to superyachts — gelcoat, brightwork, interiors, and show-ready prep.
                  </p>
                </div>
                <span class="card-domain__cta">A closer look</span>
                <span class="card-domain__visual card-domain__visual--marine">
                  <img
                    class="card-domain__img"
                    src={yacht1.src}
                    alt=""
                    width={yacht1.width}
                    height={yacht1.height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              </span>
            </a>
          </div>
        </div>
        </div>
      </div>
    </article>
      <a class="domains-spine__link" href="#aviation" data-spine="aviation">
        <span class="domains-spine__label">Aviation</span>
        <span class="domains-spine__bar" aria-hidden="true"></span>
        <span class="domains-spine__node" aria-hidden="true"></span>
      </a>
    <article id="aviation" class="domains-band domains-band--flip" aria-label="Aviation detailing">
      <div class="domains-band__stage" data-drift-scrub style="--drift-exit: 0;">
        <div class="domains-band__inner u-container" data-drifts-in>
        <div class="domains-band__layout">
          <figure class="domains-band__fig" aria-hidden="true">
            <div class="domains-band__plate rellax" data-rellax-speed="-0.4">
              <img
                src={aviationTn.src}
                alt=""
                width={aviationTn.width}
                height={aviationTn.height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="domains-band__float rellax" data-rellax-speed="0.24">
              <img
                src={jet2.src}
                alt=""
                width={jet2.width}
                height={jet2.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
          <div class="domains-band__text">
            <p class="domains-band__eyebrow">Aviation</p>
            <h3 class="domains-band__title">Finish integrity in the hangar</h3>
            <p class="domains-band__lede">
              Private aircraft exteriors and cabins — discretion, scheduling, and finish integrity first.
            </p>
            <a
              class="domains-drift__explore card-domain card-domain--aviation card-domain--mini"
              href="/aviation"
              data-domain-card
            >
              <span class="card-domain__content">
                <span class="card-domain__title">Aviation</span>
                <div class="card-domain__body">
                  <p>Private aircraft exteriors and cabins — discretion, scheduling, and finish integrity first.</p>
                </div>
                <span class="card-domain__cta">A closer look</span>
                <span class="card-domain__visual card-domain__visual--aviation">
                  <img
                    class="card-domain__img"
                    src={aviationTn.src}
                    alt=""
                    width={aviationTn.width}
                    height={aviationTn.height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              </span>
            </a>
          </div>
        </div>
        </div>
      </div>
    </article>
      <a class="domains-spine__link" href="#automotive" data-spine="automotive">
        <span class="domains-spine__label">Automotive</span>
        <span class="domains-spine__bar" aria-hidden="true"></span>
        <span class="domains-spine__node" aria-hidden="true"></span>
      </a>
    <article id="automotive" class="domains-band" aria-label="Automotive detailing">
      <div class="domains-band__stage" data-drift-scrub style="--drift-exit: 0;">
        <div class="domains-band__inner u-container" data-drifts-in>
        <div class="domains-band__layout">
          <figure class="domains-band__fig" aria-hidden="true">
            <div class="domains-band__plate rellax" data-rellax-speed="-0.38">
              <img
                src={car1.src}
                alt=""
                width={car1.width}
                height={car1.height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="domains-band__float rellax" data-rellax-speed="0.22">
              <img
                src={car2.src}
                alt=""
                width={car2.width}
                height={car2.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
          <div class="domains-band__text">
            <p class="domains-band__eyebrow">Automotive</p>
            <h3 class="domains-band__title">Paint systems that stay exceptional</h3>
            <p class="domains-band__lede">
              High-end paint correction, ceramic coating, and maintenance for exceptional road cars.
            </p>
            <a
              class="domains-drift__explore card-domain card-domain--automotive card-domain--mini"
              href="/automotive"
              data-domain-card
            >
              <span class="card-domain__content">
                <span class="card-domain__title">Automotive</span>
                <div class="card-domain__body">
                  <p>High-end paint correction, ceramic coating, and maintenance for exceptional road cars.</p>
                </div>
                <span class="card-domain__cta">A closer look</span>
                <span class="card-domain__visual card-domain__visual--automotive">
                  <img
                    class="card-domain__img"
                    src={car1.src}
                    alt=""
                    width={car1.width}
                    height={car1.height}
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              </span>
            </a>
          </div>
        </div>
        </div>
      </div>
    </article>
    </div>
  </section>
  <section class="u-section process-preview index-atmos">
    <div class="u-container process-preview__grid">
      <div>
        <p class="u-eyebrow">Process</p>
        <h2>Inspection to longevity</h2>
        <p class="u-muted">
          Every engagement begins with surfaces, environment, and how you use the asset — then we build a
          clear scope.
        </p>
      </div>
      <ul class="process-list">
        <li><strong>Inspect</strong> condition, defects, risks</li>
        <li><strong>Correct</strong> paint, gelcoat, defects</li>
        <li><strong>Protect</strong> ceramic &amp; film where appropriate</li>
        <li><strong>Maintain</strong> programs you can schedule</li>
      </ul>
    </div>
  </section>
  <section class="u-section cta-band index-atmos">
    <div class="u-container cta-band__inner">
      <div>
        <h2>Discuss your vessel, aircraft, or collection</h2>
        <p class="u-muted">Call, email, or message — we respond promptly.</p>
      </div>
      <div class="cta-band__actions">
        <a class="u-btn" href="/contact">Contact</a>
        <a class="u-btn u-btn--ghost" href={SITE.instagramUrl} target="_blank" rel="noopener noreferrer">
          Instagram
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initLoadDebug } from '../scripts/load-debug';
  import { initDomainCards } from '../scripts/domain-cards';
  import { initDomainReveal } from '../scripts/domain-reveal';
  import { initDomainsDrift } from '../scripts/domains-drift';
  import { initHeroMetrics } from '../scripts/hero-metrics';
  initLoadDebug();
  initDomainCards();
  initDomainReveal();
  initDomainsDrift();
  initHeroMetrics();
</script>

<style>
  .hero {
    position: relative;
    z-index: 2;
    /* Shared with WaveDivider strip + metrics band height */
    --hero-wave-strip-height: clamp(12.5rem, 21vw, 17rem);
    /*
      Fill the visible viewport so the wave sits flush with the bottom edge on load
      (92vh + 900px cap left a strip of .domains backdrop showing — scales wrong per display).
      100vh fallback; 100svh avoids a second layout pass when dynamic viewport units settle (felt like a “double load” on reload).
    */
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-start;
    /* Copy lives in the upper “safe zone”; wave/metrics stay absolutely at the bottom */
    padding-bottom: clamp(3rem, 8vw, 5rem);
    overflow-x: hidden;
    /* Intro scales `.hero__media`; without vertical clipping that paint can widen root overflow and flash a second scrollbar (Safari). */
    overflow-y: hidden;
  }

  /*
    Pull the hero’s paint box up under the transparent header so the photo reads from the top edge
    (same plane as the nav) instead of starting below it. Header stays z-index above for hit targets.
  */
  html[data-home-load-intro] .hero {
    /* Avoid `calc(... + var(--header-h) + ...)` — `--header-h` is a nested `calc`, invalid inside outer `calc` in WebKit. */
    margin-top: calc(0px - var(--header-bar) - var(--header-safe-pad));
    min-height: calc(
      100vh + var(--header-bar) + var(--header-safe-pad) + var(--home-prescroll-y, 0px)
    );
    min-height: calc(
      100svh + var(--header-bar) + var(--header-safe-pad) + var(--home-prescroll-y, 0px)
    );
    min-height: calc(
      var(--hero-inner-vh, 100svh) + var(--header-bar) + var(--header-safe-pad) + var(--home-prescroll-y, 0px)
    );
  }

  /* No 100dvh/100lvh overrides — they override `--hero-inner-vh` and break Safari full-height hero. */

  @supports (overflow: clip) {
    .hero {
      overflow-y: clip;
    }
  }

  @media (max-width: 480px) {
    .hero {
      --hero-wave-strip-height: clamp(10.5rem, 26vw, 14rem);
    }
  }

  /*
    Wave strip = CSS wave layers only; metrics sit above it (higher z-index) so stats stay legible.
  */
  .hero__waves {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    pointer-events: none;
    line-height: normal;
    box-sizing: border-box;
  }

  .hero__waves :global(.waves-wrap) {
    display: block;
    line-height: 0;
    overflow: hidden;
  }

  .hero__metrics {
    position: absolute;
    left: 0;
    right: 0;
    /* Clear home indicator; lift strip so stacked stats stay in view on phones */
    bottom: calc(clamp(4.25rem, 9vmin, 6rem) + env(safe-area-inset-bottom, 0px));
    height: var(--hero-wave-strip-height);
    z-index: 4;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    line-height: normal;
    overflow: visible;
    padding: 0 0 0.5rem;
    box-sizing: border-box;
    pointer-events: none;
  }

  .hero__metrics-inner {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 0;
    width: 100%;
    max-width: 56rem;
    padding-inline: var(--space-sm);
    padding-bottom: 0.4rem;
    line-height: normal;
    overflow: visible;
    transform: translate3d(0, -1cm, 0);
  }

  /*
    Homepage load choreography: blur resolve → headline parts → domains → stats rise → nav fade.
    Scoped to `html[data-home-load-intro]` so other pages are unaffected.
  */
  @keyframes homeHeroImgIntro {
    from {
      opacity: 0.25;
      filter: blur(5px) brightness(0.55);
    }

    to {
      opacity: 1;
      filter: blur(0) brightness(1);
    }
  }

  @keyframes homeWordRise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes homeFadeOnly {
    to {
      opacity: 1;
    }
  }

  @keyframes homeStatRise {
    to {
      opacity: 1;
      transform: translate3d(0, -1cm, 0);
    }
  }

  html[data-home-load-intro] .hero__media {
    transform: none;
    animation: none;
  }

  html[data-home-load-intro] .hero__img {
    opacity: 0.25;
    filter: blur(5px) brightness(0.55);
    animation: homeHeroImgIntro 2.1s cubic-bezier(0.25, 0.1, 0.25, 1) 0s forwards;
  }

  html[data-home-load-intro] .hero-load-headline__part {
    display: inline-block;
    opacity: 0;
    transform: translateY(22px);
  }

  /* Simplified sequence: text follows shortly after the softened hero settle. */
  html[data-home-load-intro] .hero-load-headline__part--1 {
    animation: homeWordRise 0.75s cubic-bezier(0.25, 0.1, 0.25, 1) 0.25s forwards;
  }

  html[data-home-load-intro] .hero-load-headline__part--2 {
    animation: homeWordRise 0.75s cubic-bezier(0.25, 0.1, 0.25, 1) 1s forwards;
  }

  html[data-home-load-intro] .hero__domain-links {
    opacity: 0;
    animation: homeFadeOnly 0.62s cubic-bezier(0.25, 0.1, 0.25, 1) 1.5s forwards;
  }

  html[data-home-load-intro] .hero__metrics-inner {
    opacity: 0;
    transform: translate3d(0, calc(-1cm + 12px), 0);
    animation: homeStatRise 0.62s cubic-bezier(0.25, 0.1, 0.25, 1) 1.5s forwards;
  }

  html[data-home-load-intro] .site-header--transparent {
    opacity: 0;
    animation: homeFadeOnly 0.62s cubic-bezier(0.25, 0.1, 0.25, 1) 1.5s forwards;
  }

  .hero__metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.35rem 0.4rem 0.45rem;
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    box-sizing: border-box;
    overflow: visible;
  }

  .hero__metric[data-count-row] {
    gap: 0.28rem;
  }

  .hero__metric:last-child {
    border-right: none;
  }

  @media (max-width: 639px) {
    .hero__metrics-inner {
      padding-inline: 0.25rem;
    }

    .hero__metric {
      padding-inline: 0.1rem;
    }
  }

  @media (max-width: 820px) and (orientation: portrait) {
    .hero__metric[data-count-row] {
      gap: 0.44rem;
    }

    .hero {
      --hero-wave-strip-height: clamp(13.5rem, 42vw, 17.5rem);
    }

    .hero__metrics {
      /*
        Safari’s bottom chrome (tabs / URL) often sits outside `safe-area-inset-bottom`.
        Large bottom inset + auto height keeps stacked stats in the live visual viewport.
      */
      bottom: calc(
        clamp(12.25rem, 46vmin, 19rem) + env(safe-area-inset-bottom, 0px) + clamp(2.5rem, 10vmin, 4.25rem)
      );
      height: auto;
      min-height: 0;
      padding-top: 0.35rem;
      padding-bottom: 0;
      align-items: flex-end;
    }

    .hero__metrics-inner {
      grid-template-columns: 1fr;
      gap: 0.72rem;
      max-width: 21rem;
      padding-bottom: 0.15rem;
    }

    .hero__metric {
      position: relative;
      border-right: none;
      border-bottom: none;
      padding: 0.48rem 0.25rem 0.52rem;
    }

    .hero__metric::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: -0.48rem;
      width: min(70%, 14.5rem);
      transform: translateX(-50%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    }

    .hero__metric:last-child {
      padding-bottom: 0.05rem;
    }

    .hero__metric:last-child::after {
      content: none;
    }

    .hero__metric-value {
      font-size: 2.1rem;
      line-height: 1.02;
    }

    .hero__metric-value--text {
      font-size: 1.5rem;
      line-height: 1.1;
    }

    .hero__metric-label {
      font-size: var(--metric-strip-caps-size-portrait);
      line-height: 1.22;
      letter-spacing: var(--metric-strip-caps-tracking-portrait);
    }
  }

  .hero__metric-value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.4rem, 3.6vw, 2.05rem);
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .hero__metric-suffix {
    font-weight: 600;
    font-size: 0.7em;
    margin-inline-start: 0.02em;
    opacity: 1;
  }

  .hero__metric-label {
    margin: 0;
    padding-bottom: 0.08rem;
    font-family: var(--font-ui);
    font-size: var(--metric-strip-caps-size);
    font-weight: var(--metric-strip-caps-weight);
    letter-spacing: var(--metric-strip-caps-tracking);
    text-transform: uppercase;
    color: rgba(239, 236, 231, 0.55);
    line-height: 1.35;
    overflow: visible;
  }

  .hero__metric-value--text {
    font-family: var(--font-hero);
    font-size: clamp(1.15rem, 2.7vw, 1.5rem);
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: none;
    font-variant-numeric: normal;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
  }

  .hero__media {
    position: absolute;
    /* Bleed into safe-area + align with hero pulled under transparent header */
    top: calc(-1 * env(safe-area-inset-top, 0px));
    right: 0;
    bottom: 0;
    left: 0;
    min-height: calc(100% + env(safe-area-inset-top, 0px) + var(--home-prescroll-y, 0px));
    z-index: 0;
    overflow: hidden;
    isolation: isolate;
    /* Charcoal ramp while the image resolves — reads softer at the top edge than flat `#050505`. */
    background: linear-gradient(180deg, #1c1e22 0%, #141518 14%, #101114 38%, #0b0c0e 100%);
  }

  /* No dedicated header feather overlay. */
  .hero__media::before {
    content: none;
  }

  .hero__img {
    position: relative;
    z-index: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    /* When cover crops only top/bottom, horizontal % does nothing — translateX always shifts the frame */
    object-position: 46% top;
    /* Nudge frame + zoom for hero crop (tune per asset). */
    transform: translate3d(
      clamp(-0.35rem, -0.85vw, 0.85rem),
      clamp(0rem, 0.35vmin, 0.45rem),
      0
    )
      scale(1.075);
    transform-origin: center top;
  }

  /*
    Tablet/mobile: keep more of the top of the source photo visible. The desktop crop nudges
    downward and zooms in more aggressively, which can read as "cut off" on iPad.
  */
  @media (max-width: 1200px) {
    .hero__img {
      object-position: 48% top;
      /*
        iPad/tablet overscan: push the frame upward so the top edge always stays photo-filled.
      */
      transform: translate3d(clamp(-0.2rem, -0.5vw, 0.3rem), -1.15rem, 0) scale(1.05);
    }
  }

  @media (max-width: 820px) {
    .hero__img {
      object-position: 50% top;
      transform: translate3d(0, -1.05rem, 0) scale(1.04);
    }
  }

  @media not (prefers-reduced-motion: reduce) {
