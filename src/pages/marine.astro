    box-shadow:
      inset 0 0 24px rgba(5, 8, 14, 0.9),
      inset 0 1px 0 rgba(32, 60, 105, 0.25),
      0 18px 40px rgba(5, 8, 14, 0.55);
    font-style: italic;
