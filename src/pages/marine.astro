      text-shadow: 0 1px 18px rgba(0, 0, 0, 0.45);
    }
  }

  /* Typography: `global.css` `--type-hero-*` + `.hero__title` / `.hero__lede`; here only photo legibility. */
  @media (min-width: 769px) {
    .marine-page .marine-hero__content > h1.hero__title {
      text-shadow: var(--type-hero-title-shadow-on-photo);
    }

    .marine-page .marine-hero__content > p.hero__lede {
      text-shadow: var(--type-hero-lede-shadow-on-photo);
    }
  }

  /*
    Hero type-in: same easing + stagger as homepage `hero-load-headline__part` / `homeWordRise`
    (index.astro): eyebrow + h1 at 0.25s, lede at 1s; eyebrow fades in from above (↓).
    Gated on `html[data-home-load-intro]` (BaseLayout default) and `.marine-page` only.
  */
  @keyframes marine-hero-word-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes marine-hero-tag-drop {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  :global(html[data-home-load-intro]) .marine-page .marine-hero__eyebrow {
    opacity: 0;
    transform: translateY(-22px);
    animation: marine-hero-tag-drop 0.75s cubic-bezier(0.25, 0.1, 0.25, 1) 0.25s forwards;
  }

  :global(html[data-home-load-intro]) .marine-page h1.hero__title {
    opacity: 0;
    transform: translateY(22px);
    animation: marine-hero-word-rise 0.75s cubic-bezier(0.25, 0.1, 0.25, 1) 0.25s forwards;
  }

  :global(html[data-home-load-intro]) .marine-page p.hero__lede {
    opacity: 0;
    transform: translateY(22px);
    animation: marine-hero-word-rise 0.75s cubic-bezier(0.25, 0.1, 0.25, 1) 1s forwards;
  }

  /*
    Solid system navy down the page (same ramp as narrow) — no editorial glass blur on desktop;
    keeps type legible over the fixed hero and matches mobile art direction.
  */
  .marine-editorial {
    position: relative;
    /* > fixed hero (z-40 in `global.css`) so editorial scrolls over the full-bleed image */
    z-index: 45;
    background: linear-gradient(
      180deg,
      var(--marine-ink) 0%,
      #070d16 18%,
      var(--marine-ink-mid) 42%,
      var(--marine-ink) 78%,
      #04060c 100%
    );
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  @media (max-width: 768px) {
    .marine-editorial {
      z-index: 1;
    }
  }

  .marine-chapter {
    padding-block: clamp(2.75rem, 7vw, 5rem);
  }

  .marine-chapter__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 860px) {
    .marine-chapter__inner {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }

    .marine-chapter--flip .marine-chapter__inner {
      direction: rtl;
    }

    .marine-chapter--flip .marine-chapter__copy,
    .marine-chapter--flip .marine-chapter__fig {
      direction: ltr;
    }
  }

  .marine-chapter__label {
    margin: 0 0 0.65rem;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.24em;
