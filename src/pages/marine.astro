---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Marine"
  description="High-end mobile marine detailing in South Florida — gelcoat correction, ceramic coating, brightwork, interiors, and boat show prep."
>
  <section class="page-hero u-container">
    <p class="u-eyebrow">Marine</p>
    <h1>Yacht &amp; vessel detailing</h1>
    <p class="u-muted page-hero__lede">
      From luxury center consoles to large motor yachts — we correct, protect, and maintain finishes in
      salt-air environments with a disciplined, inspection-first process.
    </p>
  </section>
  <section class="u-section page-body">
    <div class="u-container prose">
      <h2>Services</h2>
      <ul>
        <li>Routine wash &amp; maintenance programs</li>
        <li>Gelcoat and paint correction</li>
        <li>Ceramic coating and paint protection film (where appropriate)</li>
        <li>Brightwork, glass, and non-skid care</li>
        <li>Interior leather, vinyl, and cabin detailing</li>
        <li>Overnight and daytime boat show detailing</li>
      </ul>
      <p class="u-muted">
        Emergency and prompt scheduling available when capacity allows — call to discuss your slip, marina,
        or anchorage.
      </p>
      <p><a class="u-btn" href="/contact">Contact</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-xl) var(--space-md);
  }

  .page-hero__lede {
    max-width: 40rem;
    font-size: 1.0625rem;
  }

  .page-body {
    background: #0a1628;
  }

  .prose h2 {
    margin-top: 0;
  }

  .prose ul {
    margin: 0 0 var(--space-md);
    padding-left: 1.25rem;
    color: var(--color-cream-muted);
  }

  .prose li {
    margin-bottom: 0.35rem;
  }
</style>
