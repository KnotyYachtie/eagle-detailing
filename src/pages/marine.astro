  }

  .marine-chapter__text + .marine-chapter__text {
    margin-top: 0.85rem;
  }

  .marine-chapter__fig {
    margin: 0;
  }

  .marine-chapter__fig--depth {
    position: relative;
    perspective: 1000px;
    transform-style: preserve-3d;
  }

  .marine-chapter__shadow {
    position: absolute;
    inset: 10% 6% -6% 10%;
    z-index: 0;
    border-radius: var(--marine-img-radius);
    background: rgba(0, 0, 0, 0.45);
    filter: blur(18px);
    opacity: 0.75;
    transform: translateZ(-36px) scale(0.96);
    pointer-events: none;
  }

  .marine-chapter__shadow--alt {
    inset: 8% 10% -8% 6%;
    transform: translateZ(-42px) scale(0.94);
  }

  .marine-chapter__frame {
    position: relative;
    z-index: 1;
    border-radius: var(--marine-img-radius);
    overflow: hidden;
    box-shadow:
      0 22px 56px rgba(0, 0, 0, 0.48),
      0 0 0 1px rgba(255, 255, 255, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.07);
    aspect-ratio: 4 / 3;
    max-height: min(70vh, 28rem);
    will-change: transform;
    transform: translateZ(12px);
  }

  .marine-chapter__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: inherit;
  }

  /*
    Scroll-linked scale on the photo pixels (parent keeps Rellax translate).
    Pairs with editorial Rellax for a bit more depth; gated on view-timeline support.
  */
  @supports (animation-timeline: view(block)) {
    @keyframes marine-editorial-img-scroll-scale {
      0% {
        transform: scale(0.982);
      }
      50% {
        transform: scale(1.032);
      }
      100% {
        transform: scale(0.982);
      }
    }

    .marine-chapter__frame img {
      transform-origin: 50% 42%;
      will-change: transform;
      animation-name: marine-editorial-img-scroll-scale;
      animation-duration: 1s; /* superseded by view timeline where supported */
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view(block);
      animation-range: entry -5% exit 105%;
    }
  }

  .marine-window {
    position: relative;
    padding-block: clamp(2rem, 5vw, 3rem);
    overflow: clip;
  }

  .marine-quote {
    padding-block: clamp(2.25rem, 5vw, 3.5rem);
