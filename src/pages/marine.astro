---
import ServiceEditorialPage from '../components/ServiceEditorialPage.astro';
import { SERVICE_EDITORIAL_SHELL_COLORS } from '../site';
import mc1 from '../../assets/carousel_marine/mc-1.png';
import mc2 from '../../assets/carousel_marine/mc-2.png';
import mc3 from '../../assets/carousel_marine/mc-3.png';
import mc4 from '../../assets/carousel_marine/mc-4.png';
import mc5 from '../../assets/carousel_marine/mc-5.png';
import mc6 from '../../assets/carousel_marine/mc-6.png';
import yacht3 from '../../assets/yacht3.png';
import yacht9 from '../../assets/yacht9.png';
import yacht12 from '../../assets/yacht12.png';
import eagleSvgRaw from '../../assets/eagle.svg?raw';

const marineWindowCarouselImages = [mc1, mc2, mc3, mc4, mc5, mc6];

const eagleMarineServicesVisual = eagleSvgRaw.replace(
  /<svg[\s\S]*?>/,
  '<svg class="marine-services__eagle-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 503 408" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true">'
);
---

<ServiceEditorialPage
  title="Marine"
  description="High-end mobile marine detailing in South Florida — gelcoat correction, ceramic coating, brightwork, interiors, and boat show prep."
  themeColor={SERVICE_EDITORIAL_SHELL_COLORS.themeColor}
  canvasColor={SERVICE_EDITORIAL_SHELL_COLORS.canvasColor}
  heroEyebrow="Marine"
  heroTitle="Gelcoat to brightwork"
  heroLede="Luxury center consoles to superyachts; we correct, protect, and maintain finishes in salt-air environments with a disciplined, inspection-first process."
  chapterLeftLabelId="marine-ch-1"
  chapterLeftLabel="Condition-based approach"
  chapterLeftParagraphs={[
    "Marine finishes don't age evenly. Gelcoat oxidizes, paint fades, varnish breaks down, and brightwork dulls and rusts.",
    'Each surface needs a different approach. We assess first, then match the correction and protection to the material and its condition.',
  ]}
  chapterRightLabelId="marine-ch-2"
  chapterRightLabel="We're at your service"
  chapterRightParagraphs={[
    "Dockside, between trips, or at one of South Florida's prestigious boat shows. We work whenever and wherever the project demands. Professionalism, integrity and discretion are at the heart of our values.",
  ]}
  quoteText="The first call every time we need the boat dialed in."
  servicesEyebrowId="marine-services-label"
  servicesHeadlineId="marine-services-headline"
  servicesEyebrow="Services we offer"
  servicesHeadline="Meticulous care. Exceptional results."
  servicesLede="Comprehensive detailing and restoration services for vessels that deserve nothing less."
  servicesCtaTitle="Need immediate dockside support?"
  servicesCtaSub="Call or text anytime — we're here to help!"
  reachHeadingId="marine-reach-h"
  reachSubjectPrefix="Marine"
  reachTitle="Get in touch"
  reachLede="New clients, please use the form below. We'll review your message and reach out as soon as possible."
  reachMessageLabel="Tell us about your vessel"
  reachMessageHint="e.g. vessel name, size, location, service needed, preferred timing"
  formFieldPrefix="marine"
  carouselId="marine-featured-carousel"
  carouselAriaLabel="Featured vessel"
  carouselSlideAlt="Luxury yacht at sea — mobile marine detailing"
  heroParallax={yacht9}
  chapterLeftImage={yacht12}
  chapterLeftAlt="Motor yacht — exterior detailing"
  chapterRightImage={yacht3}
  chapterRightAlt="Yacht deck and detailing"
  carouselImages={marineWindowCarouselImages}
  eagleSvgHtml={eagleMarineServicesVisual}
>
  <ul slot="services-rows" class="marine-services__rows" role="list">
    <li class="marine-services__row">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 2.5c2.5 4 6 7.2 6 11.2a6 6 0 1 1-12 0c0-4 3.5-7.2 6-11.2z"></path>
        </svg>
      </span>
      <span class="marine-services__row-text">Wash programs &amp; ongoing care</span>
    </li>
    <li class="marine-services__row">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path>
          <circle cx="12" cy="12" r="3.5"></circle>
        </svg>
      </span>
      <span class="marine-services__row-text">Gelcoat &amp; paint correction</span>
    </li>
    <li class="marine-services__row">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 18h16M4 14h12M4 10h16M4 6h10"></path>
        </svg>
      </span>
      <span class="marine-services__row-text">Teak sanding, restoration &amp; sealing</span>
    </li>
    <li class="marine-services__row">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 22s8-4.5 8-11V5l-8-3-8 3v6c0 6.5 8 11 8 11z"></path>
        </svg>
      </span>
      <span class="marine-services__row-text">Coatings &amp; protective systems</span>
    </li>
    <li class="marine-services__row">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
        </svg>
      </span>
      <span class="marine-services__row-text">Brightwork, glass &amp; non-skid restoration</span>
    </li>
    <li class="marine-services__row">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 11V9a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v2"></path>
          <path d="M5 11h14v8a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-8zM9 15h6"></path>
        </svg>
      </span>
      <span class="marine-services__row-text">Interior &amp; cabin detailing</span>
    </li>
    <li class="marine-services__row marine-services__row--last">
      <span class="marine-services__row-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="8"></circle>
          <path d="M12 4v16M4 12h16"></path>
          <path d="M7.5 7.5l9 9M16.5 7.5l-9 9" opacity="0.35"></path>
        </svg>
      </span>
      <span class="marine-services__row-text">Dockside, emergency &amp; boat show support</span>
    </li>
  </ul>
</ServiceEditorialPage>
